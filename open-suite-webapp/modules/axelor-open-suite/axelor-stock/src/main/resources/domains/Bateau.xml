<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="stock" package="com.axelor.apps.stock.db"/>

  <!-- LVME : référentiel des bateaux (navires) utilisés sur les arrivages -->
  <entity name="Bateau">
    <string name="name" title="Bateau" namecolumn="true" required="true" unique="true"/>
  </entity>

  <!-- LVME : référentiel des containers utilisés sur les arrivages -->
  <entity name="Container">
    <string name="name" title="Container" namecolumn="true" required="true" unique="true"/>
  </entity>

</domain-models>
