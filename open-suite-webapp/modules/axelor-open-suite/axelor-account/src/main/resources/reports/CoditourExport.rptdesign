                    <property name="nativeName"></property>
                    <property name="dataType">integer</property>
                    <property name="position">2</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure><property name="position">1</property><property name="name">code_coditour</property><property name="dataType">string</property></structure>
                    <structure><property name="position">2</property><property name="name">invoice_date</property><property name="dataType">date</property></structure>
                    <structure><property name="position">3</property><property name="name">numero_facture</property><property name="dataType">string</property></structure>
                    <structure><property name="position">4</property><property name="name">devise</property><property name="dataType">string</property></structure>
                    <structure><property name="position">5</property><property name="name">type_f_a</property><property name="dataType">string</property></structure>
                    <structure><property name="position">6</property><property name="name">montant_ht</property><property name="dataType">decimal</property></structure>
                    <structure><property name="position">7</property><property name="name">montant_ttc</property><property name="dataType">decimal</property></structure>
                    <structure><property name="position">8</property><property name="name">code_fixe</property><property name="dataType">string</property></structure>
                    <structure><property name="position">9</property><property name="name">montant_ristourne</property><property name="dataType">decimal</property></structure>
                    <structure><property name="position">10</property><property name="name">periode</property><property name="dataType">string</property></structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure><property name="position">1</property><property name="name">code_coditour</property><property name="nativeName">code_coditour</property><property name="dataType">string</property></structure>
                <structure><property name="position">2</property><property name="name">invoice_date</property><property name="nativeName">invoice_date</property><property name="dataType">date</property></structure>
                <structure><property name="position">3</property><property name="name">numero_facture</property><property name="nativeName">numero_facture</property><property name="dataType">string</property></structure>
                <structure><property name="position">4</property><property name="name">devise</property><property name="nativeName">devise</property><property name="dataType">string</property></structure>
                <structure><property name="position">5</property><property name="name">type_f_a</property><property name="nativeName">type_f_a</property><property name="dataType">string</property></structure>
                <structure><property name="position">6</property><property name="name">montant_ht</property><property name="nativeName">montant_ht</property><property name="dataType">decimal</property></structure>
                <structure><property name="position">7</property><property name="name">montant_ttc</property><property name="nativeName">montant_ttc</property><property name="dataType">decimal</property></structure>
                <structure><property name="position">8</property><property name="name">code_fixe</property><property name="nativeName">code_fixe</property><property name="dataType">string</property></structure>
                <structure><property name="position">9</property><property name="name">montant_ristourne</property><property name="nativeName">montant_ristourne</property><property name="dataType">decimal</property></structure>
                <structure><property name="position">10</property><property name="name">periode</property><property name="nativeName">periode</property><property name="dataType">string</property></structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
    p.code_coditour,
    inv.invoice_date,
    inv.invoice_id AS numero_facture,
    'EUR' AS devise,
    CASE WHEN inv.operation_type_select = 3 THEN 'F' ELSE 'A' END AS type_f_a,
    inv.ex_tax_total AS montant_ht,
    inv.in_tax_total AS montant_ttc,
    '70533' AS code_fixe,
    ROUND(inv.ex_tax_total * COALESCE(so.tauxrfa, 0) / 100, 2) AS montant_ristourne,
    TO_CHAR(inv.invoice_date, 'MM/YY') AS periode
FROM account_invoice inv
JOIN base_partner p ON p.id = inv.partner
LEFT JOIN sale_sale_order so ON so.id = inv.sale_order
WHERE p.code_coditour IS NOT NULL
  AND inv.status_select = 3
  AND EXTRACT(MONTH FROM inv.invoice_date) = ?
  AND EXTRACT(YEAR FROM inv.invoice_date) = ?
ORDER BY inv.invoice_date]]></xml-property>
        </oda-data-set>
    </data-sets>
