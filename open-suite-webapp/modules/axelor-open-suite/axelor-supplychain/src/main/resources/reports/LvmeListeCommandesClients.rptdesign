ty><property name="paramName">Alerte</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">16</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_17</property><property name="paramName">Alerte</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">17</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_18</property><property name="paramName">Alerte</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">18</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_19</property><property name="paramName">Alerte</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">19</property><property name="isInput">true</property><property name="isOutput">false</property></structure></list-property><structure name="cachedMetaData"><list-property name="resultSet"><structure><property name="position">1</property><property name="name">numero</property><property name="dataType">string</property></structure><structure><property name="position">2</property><property name="name">reservation</property><property name="dataType">string</property></structure><structure><property name="position">3</property><property name="name">age_resa</property><property name="dataType">integer</property></structure><structure><property name="position">4</property><property name="name">date_cde</property><property name="dataType">date</property></structure><structure><property name="position">5</property><property name="name">client</property><property name="dataType">string</property></structure><structure><property name="position">6</property><property name="name">code</property><property name="dataType">string</property></structure><structure><property name="position">7</property><property name="name">numero_bl</property><property name="dataType">string</property></structure><structure><property name="position">8</property><property name="name">ville</property><property name="dataType">string</property></structure><structure><property name="position">9</property><property name="name">telephone</property><property name="dataType">string</property></structure><structure><property name="position">10</property><property name="name">montant</property><property name="dataType">decimal</property></structure><structure><property name="position">11</property><property name="name">marge</property><property name="dataType">decimal</property></structure><structure><property name="position">12</property><property name="name">pct_marge</property><property name="dataType">decimal</property></structure><structure><property name="position">13</property><property name="name">commercial</property><property name="dataType">string</property></structure><structure><property name="position">14</property><property name="name">responsable</property><property name="dataType">string</property></structure><structure><property name="position">15</property><property name="name">date_livraison</property><property name="dataType">date</property></structure><structure><property name="position">16</property><property name="name">preparateur</property><property name="dataType">string</property></structure><structure><property name="position">17</property><property name="name">ref_client</property><property name="dataType">string</property></structure></list-property></structure><property name="dataSource">Data Source</property><list-property name="resultSet"><structure><property name="position">1</property><property name="name">numero</property><property name="nativeName">numero</property><property name="dataType">string</property></structure><structure><property name="position">2</property><property name="name">reservation</property><property name="nativeName">reservation</property><property name="dataType">string</property></structure><structure><property name="position">3</property><property name="name">age_resa</property><property name="nativeName">age_resa</property><property name="dataType">integer</property></structure><structure><property name="position">4</property><property name="name">date_cde</property><property name="nativeName">date_cde</property><property name="dataType">date</property></structure><structure><property name="position">5</property><property name="name">client</property><property name="nativeName">client</property><property name="dataType">string</property></structure><structure><property name="position">6</property><property name="name">code</property><property name="nativeName">code</property><property name="dataType">string</property></structure><structure><property name="position">7</property><property name="name">numero_bl</property><property name="nativeName">numero_bl</property><property name="dataType">string</property></structure><structure><property name="position">8</property><property name="name">ville</property><property name="nativeName">ville</property><property name="dataType">string</property></structure><structure><property name="position">9</property><property name="name">telephone</property><property name="nativeName">telephone</property><property name="dataType">string</property></structure><structure><property name="position">10</property><property name="name">montant</property><property name="nativeName">montant</property><property name="dataType">decimal</property></structure><structure><property name="position">11</property><property name="name">marge</property><property name="nativeName">marge</property><property name="dataType">decimal</property></structure><structure><property name="position">12</property><property name="name">pct_marge</property><property name="nativeName">pct_marge</property><property name="dataType">decimal</property></structure><structure><property name="position">13</property><property name="name">commercial</property><property name="nativeName">commercial</property><property name="dataType">string</property></structure><structure><property name="position">14</property><property name="name">responsable</property><property name="nativeName">responsable</property><property name="dataType">string</property></structure><structure><property name="position">15</property><property name="name">date_livraison</property><property name="nativeName">date_livraison</property><property name="dataType">date</property></structure><structure><property name="position">16</property><property name="name">preparateur</property><property name="nativeName">preparateur</property><property name="dataType">string</property></structure><structure><property name="position">17</property><property name="name">ref_client</property><property name="nativeName">ref_client</property><property name="dataType">string</property></structure></list-property><xml-property name="queryText"><![CDATA[SELECT so.sale_order_seq AS numero, CASE WHEN so.is_reservation THEN 'Oui' ELSE '' END AS reservation,
  CASE WHEN so.is_reservation THEN current_date - DATE(COALESCE(so.confirmation_date_time, so.created_on)) END
    AS age_resa,
  so.order_date AS date_cde, cli.name AS client, cli.partner_seq AS code,
  (SELECT string_agg(sm.stock_move_seq, ', ') FROM stock_stock_move sm WHERE sm.type_select = 2 AND sm.status_select <> 4
    AND sm.id IN (SELECT x.stock_stock_move FROM stock_stock_move_sale_order_set x WHERE x.sale_order_set = so.id))
    AS numero_bl,
  city.name AS ville, cli.fixed_phone AS telephone, so.ex_tax_total AS montant, so.total_gross_margin AS marge,
  so.margin_rate AS pct_marge, com.code AS commercial, com.name AS responsable,
  so.estimated_delivery_date AS date_livraison, prep.name AS preparateur, so.external_reference AS ref_client
FROM sale_sale_order so
LEFT JOIN base_partner cli ON cli.id = so.client_partner
LEFT JOIN base_address adr ON adr.id = so.main_invoicing_address
LEFT JOIN base_city city ON city.id = adr.city
LEFT JOIN auth_user com ON com.id = so.commercial
LEFT JOIN auth_user prep ON prep.id = so.lvme_preparateur
WHERE so.template = false AND (
  (? = '' AND so.status_select IN (3, 4)
    AND ((CAST(? AS integer) = 1 AND so.status_select = 3 AND so.delivery_state <> 3
          AND (so.is_reservation IS NULL OR so.is_reservation = false))
      OR (CAST(? AS integer) = 2 AND (so.status_select = 4 OR so.delivery_state = 3)) OR CAST(? AS integer) = 3
      OR (CAST(? AS integer) = 4 AND so.is_reservation = true AND so.status_select = 3))
    AND (CAST(? AS bigint) = 0 OR so.client_partner = CAST(? AS bigint))
    AND (CAST(? AS bigint) = 0 OR so.commercial = CAST(? AS bigint))
    AND (? = '0' OR COALESCE(so.order_date, so.creation_date) BETWEEN CAST(? AS date) AND CAST(? AS date))
    AND (? = '0' OR so.estimated_delivery_date BETWEEN CAST(? AS date) AND CAST(? AS date)))
  OR (? = 'retard' AND so.status_select = 3 AND (so.delivery_state IS NULL OR so.delivery_state <> 3)
    AND so.estimated_delivery_date < current_date)
  OR (? = 'marge-negative' AND so.status_select = 3 AND (so.delivery_state IS NULL OR so.delivery_state <> 3)
    AND so.total_gross_margin < 0)
  OR (? = 'marge-faible' AND so.status_select IN (3, 4)
    AND so.order_date BETWEEN date_trunc('month', current_date)::date AND current_date AND so.margin_rate < 10)
  OR (? = 'devis' AND so.status_select IN (1, 2) AND so.creation_date < current_date - 15))
ORDER BY so.order_date DESC NULLS LAST, so.id DESC]]></xml-property></oda-data-set></data-sets><page-setup><simple-master-page name="Simple MasterPage" id="2"><property name="type">a4</property><property name="orientation">landscape</property><property name="topMargin">0.7cm</property><property name="leftMargin">0.7cm</property><property name="bottomMargin">0.7cm</property><property name="rightMargin">0.7cm</property><page-footer><grid id="1606"><property name="width">100%</property><column id="1607"/><row id="1608"><cell id="1609"><auto-text id="1610"><property name="fontSize">7pt</property><property name="textAlign">right</property><property name="type">page-number</property></auto-text></cell></row></grid></page-footer></simple-master-page></page-setup><list-property name="images"><structure><property name="name">lvme-logo.png</property><property name="type">image/png</property><property name="data"></property></structure></list-property><body><grid id="1477"><property name="width">100%</property><column id="1478"><property name="width">5cm</property></column><column id="1479"></column><column id="1480"><property name="width">6cm</property></column><row id="1481"><cell id="1473"><image id="1469"><property name="height">1.6cm</property><property name="source">embed</property><property name="imageName">lvme-logo.png</property></image></cell><cell id="1474"><property name="verticalAlign">middle</property><label id="1471"><property name="fontSize">15pt</property><property name="color">#3D3DBF</property><property name="fontWeight">bold</property><property name="textAlign">center</property><text-property name="text">Listes Commandes Clients</text-property></label><text-data id="1472"><property name="fontSize">8pt</property><property name="textAlign">center</property><property name="color">#10204A</property><expression name="valueExpr">params["Filtres"].value</expression><property name="contentType">plain</property></text-data></cell><cell id="1476"><label id="1475"><pr