ame="nativeName">arrivee_le</property><property name="dataType">date</property></structure><structure><property name="position">8</property><property name="name">transport</property><property name="nativeName">transport</property><property name="dataType">string</property></structure><structure><property name="position">9</property><property name="name">bateau</property><property name="nativeName">bateau</property><property name="dataType">string</property></structure><structure><property name="position">10</property><property name="name">containers</property><property name="nativeName">containers</property><property name="dataType">string</property></structure><structure><property name="position">11</property><property name="name">nb_colis</property><property name="nativeName">nb_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">12</property><property name="name">poids</property><property name="nativeName">poids</property><property name="dataType">decimal</property></structure><structure><property name="position">13</property><property name="name">montant</property><property name="nativeName">montant</property><property name="dataType">decimal</property></structure><structure><property name="position">14</property><property name="name">telephone</property><property name="nativeName">telephone</property><property name="dataType">string</property></structure><structure><property name="position">15</property><property name="name">ville</property><property name="nativeName">ville</property><property name="dataType">string</property></structure><structure><property name="position">16</property><property name="name">pays</property><property name="nativeName">pays</property><property name="dataType">string</property></structure><structure><property name="position">17</property><property name="name">frigo</property><property name="nativeName">frigo</property><property name="dataType">string</property></structure></list-property><xml-property name="queryText"><![CDATA[SELECT COALESCE(p.simple_full_name, p.name) AS fournisseur, sm.stock_move_seq AS numero,
  CASE sm.nature WHEN 0 THEN 'Brouillon' WHEN 1 THEN 'Flottant' WHEN 2 THEN 'Flottant' WHEN 3 THEN 'Réel' WHEN 4 THEN 'Annulé' ELSE '' END AS nature, CASE WHEN sm.nature = 1 THEN 'Oui' ELSE '' END AS a_embarquer,
  sm.supplier_shipment_date AS date_depart, sm.estimated_date AS arrivee_prevue, sm.real_date AS arrivee_le,
  shm.name AS transport, bt.name AS bateau,
  (SELECT string_agg(c.name, ', ') FROM stock_stock_move_container_set cs JOIN stock_container c ON c.id = cs.container_set
    WHERE cs.stock_stock_move = sm.id) AS containers,
  sm.nb_colis_total AS nb_colis, sm.poids_total AS poids, sm.ex_tax_total AS montant, p.fixed_phone AS telephone,
  city.name AS ville, pays.name AS pays, fr.name AS frigo
FROM stock_stock_move sm
LEFT JOIN base_partner p ON p.id = sm.partner
LEFT JOIN stock_shipment_mode shm ON shm.id = sm.shipment_mode
LEFT JOIN stock_bateau bt ON bt.id = sm.bateau
LEFT JOIN base_address adr ON adr.id = sm.from_address
LEFT JOIN base_city city ON city.id = adr.city
LEFT JOIN base_country pays ON pays.id = adr.country
LEFT JOIN stock_stock_location fr ON fr.id = sm.to_stock_location
WHERE sm.type_select = 3 AND sm.is_reversion = false
  AND LOWER(COALESCE(sm.stock_move_seq, '')) LIKE ?
  AND (CAST(? AS bigint) = 0 OR sm.partner = CAST(? AS bigint))
  AND (? = '0' OR CAST(sm.created_on AS date) BETWEEN CAST(? AS date) AND CAST(? AS date))
  AND (? = '0' OR sm.real_date BETWEEN CAST(? AS date) AND CAST(? AS date)
    OR (sm.real_date IS NULL AND sm.estimated_date BETWEEN CAST(? AS date) AND CAST(? AS date)))
  AND ((CAST(? AS integer) = 4 AND sm.archived = true)
    OR (CAST(? AS integer) <> 4 AND (sm.archived IS NULL OR sm.archived = false)
      AND ((CAST(? AS integer) = 1 AND sm.nature IN (0, 1, 2, 3)) OR (CAST(? AS integer) = 2 AND sm.nature = 3)
        OR (CAST(? AS integer) = 3 AND sm.nature IN (1, 2)))))
ORDER BY sm.estimated_date DESC NULLS LAST, sm.id DESC]]></xml-property></oda-data-set></data-sets><page-setup><simple-master-page name="Simple MasterPage" id="2"><property name="type">a4</property><property name="orientation">landscape</property><property name="topMargin">0.7cm</property><property name="leftMargin">0.7cm</property><property name="bottomMargin">0.7cm</property><property name="rightMargin">0.7cm</property><page-footer><grid id="1248"><property name="width">100%</property><column id="1249"/><row id="1250"><cell id="1251"><auto-text id="1252"><property name="fontSize">7pt</property><property name="textAlign">right</property><property name="type">page-number</property></auto-text></cell></row></grid></page-footer></simple-master-page></page-setup><list-property name="images"><structure><property name="name">lvme-logo.png</property><property name="type">image/png</property><property name="data"></property></structure></list-property><body><grid id="1119"><property name="width">100%</property><column id="1120"><property name="width">5cm</property></column><column id="1121"></column><column id="1122"><property name="width">6cm</property></column><row id="1123"><cell id="1115"><image id="1111"><property name="height">1.6cm</property><property name="source">embed</property><property name="imageName">lvme-logo.png</property></image></cell><cell id="1116"><property name="verticalAlign">middle</property><label id="1113"><property name="fontSize">15pt</property><property name="color">#3D3DBF</property><property name="fontWeight">bold</property><property name="textAlign">center</property><text-property name="text">Arrivages</text-property></label><text-data id="1114"><property name="fontSize">8pt</property><property name="textAlign">center</property><property name="color">#10204A</property><expression name="valueExpr">params["Filtres"].value</expression><property name="contentType">plain</property></text-data></cell><cell id="1118"><label id="1117"><property name