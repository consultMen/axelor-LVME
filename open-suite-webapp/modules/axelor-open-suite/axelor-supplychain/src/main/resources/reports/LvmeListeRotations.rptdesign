operty><property name="name">fournisseur</property><property name="nativeName">fournisseur</property><property name="dataType">string</property></structure><structure><property name="position">4</property><property name="name">frigo</property><property name="nativeName">frigo</property><property name="dataType">string</property></structure><structure><property name="position">5</property><property name="name">transport</property><property name="nativeName">transport</property><property name="dataType">string</property></structure><structure><property name="position">6</property><property name="name">lot</property><property name="nativeName">lot</property><property name="dataType">string</property></structure><structure><property name="position">7</property><property name="name">arrivage</property><property name="nativeName">arrivage</property><property name="dataType">string</property></structure><structure><property name="position">8</property><property name="name">origine</property><property name="nativeName">origine</property><property name="dataType">string</property></structure><structure><property name="position">9</property><property name="name">conditionnement</property><property name="nativeName">conditionnement</property><property name="dataType">string</property></structure><structure><property name="position">10</property><property name="name">marque</property><property name="nativeName">marque</property><property name="dataType">string</property></structure><structure><property name="position">11</property><property name="name">gencode</property><property name="nativeName">gencode</property><property name="dataType">string</property></structure><structure><property name="position">12</property><property name="name">arrivee_le</property><property name="nativeName">arrivee_le</property><property name="dataType">date</property></structure><structure><property name="position">13</property><property name="name">dluo</property><property name="nativeName">dluo</property><property name="dataType">date</property></structure><structure><property name="position">14</property><property name="name">prix_revient</property><property name="nativeName">prix_revient</property><property name="dataType">decimal</property></structure><structure><property name="position">15</property><property name="name">poids_colis</property><property name="nativeName">poids_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">16</property><property name="name">poids_entrees</property><property name="nativeName">poids_entrees</property><property name="dataType">decimal</property></structure><structure><property name="position">17</property><property name="name">colis_entrees</property><property name="nativeName">colis_entrees</property><property name="dataType">decimal</property></structure><structure><property name="position">18</property><property name="name">colis_stock</property><property name="nativeName">colis_stock</property><property name="dataType">decimal</property></structure><structure><property name="position">19</property><property name="name">poids_stock</property><property name="nativeName">poids_stock</property><property name="dataType">decimal</property></structure><structure><property name="position">20</property><property name="name">valeur_stock</property><property name="nativeName">valeur_stock</property><property name="dataType">decimal</property></structure><structure><property name="position">21</property><property name="name">jours_stock</property><property name="nativeName">jours_stock</property><property name="dataType">integer</property></structure><structure><property name="position">22</property><property name="name">derniere_sortie</property><property name="nativeName">derniere_sortie</property><property name="dataType">date</property></structure><structure><property name="position">23</property><property name="name">jours_rotation</property><property name="nativeName">jours_rotation</property><property name="dataType">integer</property></structure></list-property><xml-property name="queryText"><![CDATA[SELECT r.product_code AS produit, r.product_name AS designation, r.supplier_name AS fournisseur,
  loc.name AS frigo, t.transport, r.lot_number AS lot, r.arrival_number AS arrivage, r.origine, r.conditionnement,
  r.marque, r.gencode, r.arrival_date AS arrivee_le, r.dluo, r.prix_revient, r.poids_colis, r.poids_entrees,
  r.nb_colis_in AS colis_entrees, r.nb_colis_stock AS colis_stock, r.poids_stock, r.stock_value AS valeur_stock,
  r.stock_days AS jours_stock, r.last_sale_date AS derniere_sortie, r.rotation_days AS jours_rotation
FROM lvme_rotation_lot r
LEFT JOIN stock_stock_location loc ON loc.id = r.stock_location_id
LEFT JOIN LATERAL (SELECT (SELECT shm.name FROM stock_shipment_mode shm WHERE shm.id = (
    SELECT COALESCE(sm.shipment_mode, (SELECT MAX(po.shipment_mode) FROM purchase_purchase_order po WHERE po.id IN (
      SELECT x.purchase_order_set FROM stock_stock_move_purchase_order_set x WHERE x.stock_stock_move = sm.id)))
    FROM stock_stock_move sm WHERE sm.id = (SELECT sml.stock_move FROM stock_stock_move_line sml WHERE sml.id = (
      SELECT tn.origin_stock_move_line FROM stock_tracking_number tn WHERE tn.id = r.tracking_number_id)))) AS transport) t
  ON true
WHERE (? = '' OR r.product_code >= ?) AND (? = '' OR r.product_code <= ?)
  AND (? = '' OR r.supplier_name >= ?) AND (? = '' OR r.supplier_name <= ?)
  AND (CAST(? AS bigint) = 0 OR r.product_category_id = CAST(? AS bigint))
  AND (CAST(? AS bigint) = 0 OR r.stock_location_id = CAST(? AS bigint))
  AND (? = '' OR r.origine = ?)
  AND (? = '0' OR r.arrival_date BETWEEN CAST(? AS date) AND CAST(? AS date))
  AND (? = '' OR t.transport = ?)
ORDER BY r.product_code, r.arrival_date, r.lot_number]]></xml-property></oda-data-set></data-sets><page-setup><simple-master-page name="Simple MasterPage" id="2"><property name="type">a4</property><property name="orientation">landscape</property><property name="topMargin">0.7cm</property><property name="leftMargin">0.7cm</property><property name="bottomMargin">0.7cm</property><property name="rightMargin">0.7cm</property><page-footer><grid id="1463"><property name="width">100%</property><column id="1464"/><row id="1465"><cell id="1466"><auto-text id="1467"><property name="fontSize">7pt</property><property name="textAlign">right</property><property name="type">page-number</property></auto-text></cell></row></grid></page-footer></simple-master-page></page-setup><list-property name="images"><structure><property name="name">lvme-logo.png</property><property name="type">image/png</property><property name="data"></property></structure></list-property><body><grid id="1262"><property name="width">100%</property><column id="1263"><property name="width">5cm</property></column><column id="1264"></column><column id="1265"><property name="width">6cm</property></column><row id="1266"><cell id="1258"><image id="1254"><property name="height">1.6cm</property><property name="source">embed</property><property name="imageName">lvme-logo.png</property></image></cell><cell id="1259"><property name="verticalAlign">middle</property><label id="1256"><property name="fontSize">15pt</property><property name="color">#3D3DBF</property><property name="fontWeight">bold</property><property name="textAlign">center</property><text-property name="text">Liste des Rotations</text-property></label><text-data id="1257"><property name="fontSize">8pt</property><property name="textAlign">center</property><property name="color">#10204A</property><expression name="valueExpr">params["Filtres"].value</expression><property name="contentType">plain</property></text-data></cell><cell id="1261"><label id="1260"><prop