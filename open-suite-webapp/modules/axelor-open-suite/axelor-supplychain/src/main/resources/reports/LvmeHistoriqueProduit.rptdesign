rty name="name">poids_sorties</property><property name="dataType">decimal</property></structure><structure><property name="position">8</property><property name="name">stock_periode</property><property name="dataType">decimal</property></structure></list-property></structure><property name="dataSource">Data Source</property><list-property name="resultSet"><structure><property name="position">1</property><property name="name">produit_code</property><property name="nativeName">produit_code</property><property name="dataType">string</property></structure><structure><property name="position">2</property><property name="name">produit_nom</property><property name="nativeName">produit_nom</property><property name="dataType">string</property></structure><structure><property name="position">3</property><property name="name">du</property><property name="nativeName">du</property><property name="dataType">string</property></structure><structure><property name="position">4</property><property name="name">au</property><property name="nativeName">au</property><property name="dataType">string</property></structure><structure><property name="position">5</property><property name="name">total_colis</property><property name="nativeName">total_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">6</property><property name="name">poids_entrees</property><property name="nativeName">poids_entrees</property><property name="dataType">decimal</property></structure><structure><property name="position">7</property><property name="name">poids_sorties</property><property name="nativeName">poids_sorties</property><property name="dataType">decimal</property></structure><structure><property name="position">8</property><property name="name">stock_periode</property><property name="nativeName">stock_periode</property><property name="dataType">decimal</property></structure></list-property><xml-property name="queryText"><![CDATA[SELECT p.code AS produit_code, p.name AS produit_nom,
  to_char(CAST(? AS date), 'DD/MM/YYYY') AS du, to_char(CAST(? AS date), 'DD/MM/YYYY') AS au,
  COALESCE(t.colis, 0) AS total_colis, COALESCE(t.entrees, 0) AS poids_entrees, COALESCE(t.sorties, 0) AS poids_sorties,
  COALESCE(t.entrees, 0) - COALESCE(t.sorties, 0) AS stock_periode
FROM base_product p
LEFT JOIN LATERAL (SELECT sum(hp.nb_colis) AS colis, sum(hp.poids_entree) AS entrees, sum(hp.poids_sortie) AS sorties
  FROM lvme_historique_produit hp WHERE hp.product_id = ? AND hp.date_mvt BETWEEN CAST(? AS date) AND CAST(? AS date)) t ON true
WHERE p.id = ?]]></xml-property></oda-data-set><oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="LignesDS" id="1151"><list-property name="parameters"><structure><property name="name">param_1</property><property name="paramName">ProduitId</property><property name="dataType">decimal</property><property name="nativeDataType">-5</property><property name="position">1</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_2</property><property name="paramName">DateDu</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">2</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_3</property><property name="paramName">DateAu</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">3</property><property name="isInput">true</property><property name="isOutput">false</property></structure></list-property><structure name="cachedMetaData"><list-property name="resultSet"><structure><property name="position">1</property><property name="name">arrivage</property><property name="dataType">string</property></structure><structure><property name="position">2</property><property name="name">date_mvt</property><property name="dataType">date</property></structure><structure><property name="position">3</property><property name="name">lot_number</property><property name="dataType">string</property></structure><structure><property name="position">4</property><property name="name">libelle</property><property name="dataType">string</property></structure><structure><property name="position">5</property><property name="name">type_mvt</property><property name="dataType">string</property></structure><structure><property name="position">6</property><proper