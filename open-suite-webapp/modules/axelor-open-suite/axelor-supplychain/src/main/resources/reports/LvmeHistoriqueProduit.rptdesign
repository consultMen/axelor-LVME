><property name="dataType">string</property></structure><structure><property name="position">6</property><property name="name">ref_tiers</property><property name="nativeName">ref_tiers</property><property name="dataType">string</property></structure><structure><property name="position">7</property><property name="name">prix_vente</property><property name="nativeName">prix_vente</property><property name="dataType">decimal</property></structure><structure><property name="position">8</property><property name="name">prix_revient</property><property name="nativeName">prix_revient</property><property name="dataType">decimal</property></structure><structure><property name="position">9</property><property name="name">poids_colis</property><property name="nativeName">poids_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">10</property><property name="name">nb_colis</property><property name="nativeName">nb_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">11</property><property name="name">poids_entree</property><property name="nativeName">poids_entree</property><property name="dataType">decimal</property></structure><structure><property name="position">12</property><property name="name">poids_sortie</property><property name="nativeName">poids_sortie</property><property name="dataType">decimal</property></structure></list-property><xml-property name="queryText"><![CDATA[SELECT hp.arrivage, hp.date_mvt, hp.lot_number, hp.libelle, hp.type_mvt, hp.ref_tiers, hp.prix_vente,
  hp.prix_revient, hp.poids_colis, hp.nb_colis, hp.poids_entree, hp.poids_sortie
FROM lvme_historique_produit hp
WHERE hp.product_id = ? AND hp.date_mvt BETWEEN CAST(? AS date) AND CAST(? AS date)
ORDER BY hp.date_mvt, hp.id]]></xml-property></oda-data-set></data-sets><page-setup><simple-master-page name="Simple MasterPage" id="2"><property name="type">a4</property><property name="orientation">landscape</property><property name="topMargin">0.8cm</property><property name="leftMargin">0.8cm</property><property name="bottomMargin">0.8cm</property><property name="rightMargin">0.8cm</property><page-footer><grid id="1152"><property name="width">100%</property><column id="1153"/><row id="1154"><cell id="1155"><auto-text id="1156"><property name="fontSize">7pt</property><property name="textAlign">right</property><property name="type">page-number</property></auto-text></cell></row></grid></page-footer></simple-master-page></page-setup><list-property name="images"><structure><property name="name">lvme-logo.png</property><property name="type">image/png</property><property name="data"></property></structure></list-property><body><list id="1061"><property name="dataSet">EnteteDS</property><list-property name="boundDataColumns"><structure><property name="name">produit_code</property><expression name="expression" type="javascript">dataSetRow["produit_code"]</expression><property name="dataType">string</property></structure><structure><property name="name">produit_nom</property><expression name="expression" type="javascript">dataSetRow["produit_nom"]</expression><property name="dataType">string</property></structure><structure><property name="name">du</property><expression name="expression" type="javascript">dataSetRow["du"]</expression><property name="dataType">string</property></structure><structure><property name="name">au</property><expression name="expression" type="javascript">dataSetRow["au"]</expression><property name="dataType">string</property></structure><structure><property name="name">total_colis</property><expression name="expression" type="javascript">dataSetRow["total_colis"]</expression><property name="dataType">decimal</property></structure><structure><prop