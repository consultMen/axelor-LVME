me">param_28</property><property name="paramName">NAu</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">28</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_29</property><property name="paramName">NunDu</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">29</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_30</property><property name="paramName">NunAu</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">30</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_31</property><property name="paramName">RDu</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">31</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_32</property><property name="paramName">RAu</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">32</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_33</property><property name="paramName">Conditionnement</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">33</property><property name="isInput">true</property><property name="isOutput">false</property></structure><structure><property name="name">param_34</property><property name="paramName">Conditionnement</property><property name="dataType">string</property><property name="nativeDataType">12</property><property name="position">34</property><property name="isInput">true</property><property name="isOutput">false</property></structure></list-property><structure name="cachedMetaData"><list-property name="resultSet"><structure><property name="position">1</property><property name="name">produit</property><property name="dataType">string</property></structure><structure><property name="position">2</property><property name="name">designation</property><property name="dataType">string</property></structure><structure><property name="position">3</property><property name="name">condt</property><property name="dataType">string</property></structure><structure><property name="position">4</property><property name="name">conditionnement</property><property name="dataType">string</property></structure><structure><property name="position">5</property><property name="name">colis_n</property><property name="dataType">decimal</property></structure><structure><property name="position">6</property><property name="name">colis_n1</property><property name="dataType">decimal</property></structure><structure><property name="position">7</property><property name="name">poids_n</property><property name="dataType">decimal</property></structure><structure><property name="position">8</property><property name="name">poids_n1</property><property name="dataType">decimal</property></structure><structure><property name="position">9</property><property name="name">evolution</property><property name="dataType">decimal</property></structure><structure><property name="position">10</property><property name="name">poids_p2</property><property name="dataType">decimal</property></structure><structure><property name="position">11</property><property name="name">stock</property><property name="dataType">decimal</property></structure><structure><property name="position">12</property><property name="name">a_commander</property><property name="dataType">decimal</property></structure><structure><property name="position">13</property><property name="name">rang</property><property name="dataType">integer</property></structure><structure><property name="position">14</property><property name="name">vide</property><property name="dataType">string</property></structure></list-property></structure><property name="dataSource">Data Source</property><list-property name="resultSet"><structure><property name="position">1</property><property name="name">produit</property><property name="nativeName">produit</property><property name="dataType">string</property></structure><structure><property name="position">2</property><property name="name">designation</property><property name="nativeName">designation</property><property name="dataType">string</property></structure><structure><property name="position">3</property><property name="name">condt</property><property name="nativeName">condt</property><property name="dataType">string</property></structure><structure><property name="position">4</property><property name="name">conditionnement</property><property name="nativeName">conditionnement</property><property name="dataType">string</property></structure><structure><property name="position">5</property><property name="name">colis_n</property><property name="nativeName">colis_n</property><property name="dataType">decimal</property></structure><structure><property name="position">6</property><property name="name">colis_n1</property><property name="nativeName">colis_n1</property><property name="dataType">decimal</property></structure><structure><property name="position">7</property><property name="name">poids_n</property><property name="nativeName">poids_n</property><property name="dataType">decimal</property></structure><structure><property name="position">8</property><property name="name">poids_n1</property><property name="nativeName">poids_n1</property><property name="dataType">decimal</property></structure><structure><property name="position">9</property><property name="name">evolution</property><property name="nativeName">evolution</property><property name="dataType">decimal</property></structure><structure><property name="position">10</property><property name="name">poids_p2</property><property name="nativeName">poids_p2</property><property name="dataType">decimal</property></structure><structure><property name="position">11</property><property name="name">stock</property><property name="nativeName">stock</property><property name="dataType">decimal</property></structure><structure><property name="position">12</property><property name="name">a_commander</property><property name="nativeName">a_commander</property><property name="dataType">decimal</property></structure><structure><property name="position">13</property><property name="name">rang</property><property name="nativeName">rang</property><property name="dataType">integer</property></structure><structure><property name="position">14</property><property name="name">vide</property><property name="nativeName">vide</property><property name="dataType">string</property></structure></list-property><xml-property name="queryText"><![CDATA[WITH lignes AS (
  SELECT sol.product, sol.conditionnement AS cond, sol.nb_colis, sol.poids_total_net AS poids,
         COALESCE((SELECT COALESCE(sm.real_date, sm.estimated_date) FROM stock_stock_move sm
                   WHERE sm.id = (SELECT max(sml.stock_move) FROM stock_stock_move_line sml
                                  WHERE sml.sale_order_line = sol.id AND sml.stock_move IN (
                                    SELECT s.id FROM stock_stock_move s WHERE s.status_select <> 4))),
                  so.order_date, so.creation_date) AS dt
  FROM sale_sale_order_line sol
  JOIN sale_sale_order so ON so.id = sol.sale_order
  JOIN base_partner cli ON cli.id = so.client_partner
  JOIN base_product pr ON pr.id = sol.product
  LEFT JOIN base_address adr ON adr.id = cli.main_address
  LEFT JOIN auth_user com ON com.id = cli.commercial
  WHERE so.template = false AND so.status_select IN (3, 4)
    AND (CAST(? AS bigint) = 0 OR so.client_partner = CAST(? AS bigint))
    AND (CAST(? AS bigint) = 0 OR cli.partner_category = CAST(? AS bigint))
    AND (? = '' OR coalesce(com.code, '') >= ?) AND (? = '' OR coalesce(com.code, '') <= ?)
    AND (CAST(? AS bigint) = 0 OR adr.country = CAST(? AS bigint))
    AND (CAST(? AS bigint) = 0 OR cli.groupement = CAST(? AS bigint))
    AND (CAST(? AS bigint) = 0 OR sol.product = CAST(? AS bigint))
    AND (CAST(? AS bigint) = 0 OR pr.product_category = CAST(? AS bigint))
    AND (CAST(? AS bigint) = 0 OR pr.default_supplier_partner = CAST(? AS bigint))
    AND (? = '' OR EXISTS (SELECT 1 FROM purchase_conditionnement pc WHERE pc.id = sol.conditionnement
           AND lower(coalesce(pc.code, '') || ' ' || coalesce(pc.label, '')) LIKE '%' || lower(?) || '%'))
    AND (? = '' OR EXISTS (SELECT 1 FROM supplychain_sale_order_line_lot x
           JOIN stock_tracking_number tn ON tn.id = x.tracking_number
           JOIN stock_stock_move_line oml ON oml.id = tn.origin_stock_move_line
           WHERE x.sale_order_line = sol.id AND oml.origine = ?))),
v AS (
  SELECT l.product, coalesce(pc.label, pc.code, '') AS cond_label, min(pc.code) AS cond_code,
         sum(l.nb_colis) FILTER (WHERE l.dt BETWEEN CAST(? AS date) AND CAST(? AS date)) AS colis_n,
         sum(l.nb_colis) FILTER (WHERE l.dt BETWEEN CAST(? AS date) AND CAST(? AS date)) AS colis_n1,
         sum(l.poids) FILTER (WHERE l.dt BETWEEN CAST(? AS date) AND CAST(? AS date)) AS poids_n,
         sum(l.poids) FILTER (WHERE l.dt BETWEEN CAST(? AS date) AND CAST(? AS date)) AS poids_n1,
         sum(l.poids) FILTER (WHERE l.dt BETWEEN CAST(? AS date) AND CAST(? AS date)) AS poids_p2
  FROM lignes l LEFT JOIN purchase_conditionnement pc ON pc.id = l.cond
  GROUP BY l.product, coalesce(pc.label, pc.code, '')),
vl AS (SELECT * FROM v WHERE coalesce(colis_n, 0) <> 0 OR coalesce(poids_n, 0) <> 0 OR coalesce(colis_n1, 0) <> 0
         OR coalesce(poids_n1, 0) <> 0 OR coalesce(poids_p2, 0) <> 0),
st AS (
  SELECT e.product_id AS product, coalesce(e.conditionnement, '') AS cond_label, sum(e.stock_qty) AS stock
  FROM lvme_etat_stock_lot e
  WHERE e.stock_qty <> 0 AND e.product_id IN (SELECT product FROM vl)
    AND (? = '' OR lower(coalesce(e.conditionnement, '')) LIKE '%' || lower(?) || '%')
  GROUP BY e.product_id, coalesce(e.conditionnement, '')),
k AS (SELECT product, cond_label FROM vl UNION SELECT product, cond_label FROM st),
r AS (
  SELECT pr.code AS produit, pr.name AS designation,
         coalesce(vl.cond_code, (SELECT min(pc.code) FROM purchase_conditionnement pc WHERE pc.label = k.cond_label))
           AS condt,
         NULLIF(k.cond_label, '') AS conditionnement, vl.colis_n, vl.colis_n1, vl.poids_n, vl.poids_n1,
         CASE WHEN vl.poids_n1 > 0 THEN round((coalesce(vl.poids_n, 0) - vl.poids_n1) * 100 / vl.poids_n1, 1) END
           AS evolution,
         vl.poids_p2, st.stock
  FROM k
  JOIN base_product pr ON pr.id = k.product
  LEFT JOIN vl ON vl.product = k.product AND vl.cond_label = k.cond_label
  LEFT JOIN st ON st.product = k.product AND st.cond_label = k.cond_label)
SELECT produit, designation, condt, conditionnement, colis_n, colis_n1, poids_n, poids_n1, evolution, poids_p2, stock,
       round(coalesce(poids_p2, 0) * (1 + coalesce(evolution, 0) / 100) - coalesce(stock, 0), 3) AS a_commander,
       dense_rank() OVER (ORDER BY produit) AS rang, NULL::text AS vide
FROM r
ORDER BY produit, condt, conditionnement]]></xml-property></oda-data-set></data-sets><page-setup><simple-master-page name="Simple MasterPage" id="2"><property name="type">a4</property><property name="orientation">landscape</property><property name="topMargin">0.7cm</property><property name="leftMargin">0.7cm</property><property name="bottomMargin">0.7cm</property><property name="rightMargin">0.7cm</property><page-footer><grid id="2817"><property name="width">100%</property><column id="2818"/><row id="2819"><cell id="2820"><auto-text id="2821"><property name="fontSize">7pt</property><property name="textAlign">right</property><property name="type">page-number</property></auto-text></cell></row></grid></page-footer></simple-master-page></page-setup><list-property name="images"><structure><property name="name">lvme-logo.png</property><property name="type">image/png</property><property name="data"></property></structure></list-property><body><grid id="2675"><property name="width">100%</property><column id="2676"><property name="width">5cm</property></column><column id="2677"></column><column id="2678"><property name="width">6cm</property></column><row id="2679"><cell id="2671"><image id="2667"><property name="height">1.6cm</property><property name="source">embed</property><property name="imageName">lvme-logo.png</property></image></cell><cell id="2672"><property name="verticalAlign">middle</property><label id="2669"><property name="fontSize">15pt</property><property name="color">#3D3DBF</property><property name="fontWeight">bold</property><property name="textAlign">center</property><text-property name="text">Aides aux Réapprovisionnements</text-property></label><text-data id="2670"><property name="fontSize">8pt</property><property name="textAlign">center</property><property name="color">#10204A</property><expression name="valueExpr">params["Periodes"].value + "\n" + params["Filtres"].value</expression><property name="contentType">plain</property></text-data></cell><cell 