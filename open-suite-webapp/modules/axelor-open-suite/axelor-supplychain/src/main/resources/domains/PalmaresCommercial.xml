<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
  https://axelor.com/xml/ns/domain-models/domain-models_7.0.xsd">

  <module name="supplychain" package="com.axelor.apps.supplychain.db"/>

  <entity name="PalmaresCommercial" cacheable="false">
    <many-to-one name="commercial" ref="com.axelor.auth.db.User" title="Commercial"/>
    <decimal name="caHt" title="CA HT" scale="2" precision="20"/>
    <decimal name="montantCommission" title="Montant Commission à payer" scale="2"
      precision="20"/>
  </entity>

  <entity name="PalmaresCommercialWizard" cacheable="false">
    <date name="dateDe" title="Date de"/>
    <date name="dateA" title="Date à"/>
  </entity>

</domain-models>