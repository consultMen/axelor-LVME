<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="purchase" package="com.axelor.apps.purchase.db"/>

  <entity name="PurchaseOrder">

    <many-to-one name="paymentMode" ref="com.axelor.apps.account.db.PaymentMode"
      title="Payment mode"/>
    <many-to-one name="paymentCondition"
      ref="com.axelor.apps.account.db.PaymentCondition" title="Payment condition"/>

    <decimal name="amountInvoiced" title="Amount invoiced W.T." readonly="true"
      precision="20" scale="3"/>

    <many-to-one name="stockLocation" ref="com.axelor.apps.stock.db.StockLocation"
      title="Stock location"/>
    <many-to-one name="fromStockLocation" ref="com.axelor.apps.stock.db.StockLocation"
      title="From stock location"/>

    <one-to-many name="timetableList" ref="com.axelor.apps.supplychain.db.Timetable"
      title="Timetable" mappedBy="purchaseOrder"/>
    <date name="expectedRealisationDate" title="Expected realisation date"/>
    <boolean name="interco" title="Interco"/>
    <boolean name="createdByInterco" default="false"/>
    <many-to-one name="shipmentMode" ref="com.axelor.apps.stock.db.ShipmentMode"/>
    <!-- LVME : Nature de l'arrivage (recopiée depuis la réception fournisseur) -->
    <enum name="nature" ref="com.axelor.apps.stock.db.Nature" title="Nature" readonly="true"/>
    <!-- LVME : taux de change de l'écran GESCOM, pour archivage seulement (n'entre dans aucun calcul) -->
    <decimal name="lvmeCours" title="Cours" precision="20" scale="4" nullable="true"/>
    <decimal name="lvmeCouvert" title="Couvert" precision="20" scale="4" nullable="true"/>
    <decimal name="lvmeFlottant" title="Flottant" precision="20" scale="4" nullable="true"/>
    <decimal name="lvmeReel" title="Réel" precision="20" scale="4" nullable="true"/>
    <boolean name="lvmeAEmbarquer" title="À embarquer" formula="true">
      <![CDATA[
      nature = 1
      ]]>
    </boolean>
    <!-- LVME : ordre des cartes dans le Kanban (déplacement des cartes) -->
    <integer name="lvmeKanbanSeq" title="Ordre Kanban"/>
    <!-- LVME : étape de la commande d'achat (Kanban et barre de la fiche) : 1 Brouillon / demandée, 2 À embarquer,
      3 Flottant, 4 En stock, 5 Annulée -->
    <integer name="lvmeEtapeAchat" title="Étape" selection="lvme.achat.etape.select"
      formula="true">
      <![CDATA[
      (CASE WHEN status_select = 5 OR nature = 4 THEN 5 WHEN status_select = 4 OR nature = 3 THEN 4
        WHEN nature = 2 THEN 3 WHEN status_select = 3 THEN 2 ELSE 1 END)
      ]]>
    </integer>
    <!-- LVME : réception prévue dépassée et pas encore réceptionnée (carte en rouge dans le Kanban) -->
    <boolean name="lvmeEnRetard" title="En retard" formula="true">
      <![CDATA[
      (estimated_receipt_date < date(now()) AND status_select IN (1, 2, 3) AND COALESCE(nature, 0) NOT IN (3, 4))
      ]]>
    </boolean>
    <many-to-one name="freightCarrierMode"
      ref="com.axelor.apps.stock.db.FreightCarrierMode"/>

    <long name="generatedSaleOrderId"/>
    <extra-code>
            <![CDATA[
                // INVOICE
                public static final int INVOICE_ALL = 1;
                public static final int INVOICE_ADVANCE_PAYMENT = 2;

            ]]>
    </extra-code>
  </entity>

</domain-models>
