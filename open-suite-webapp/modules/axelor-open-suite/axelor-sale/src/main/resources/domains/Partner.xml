<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_7.4.xsd">

  <module name="base" package="com.axelor.apps.base.db"/>

  <entity name="Partner">
    <string name="saleOrderInformation" title="Label to be displayed on sale orders"
      multiline="true" large="true"/>
    <string name="specificTaxNote" title="Specific tax note" large="true"/>
    <one-to-many name="customerCatalogList"
      ref="com.axelor.apps.sale.db.CustomerCatalog" mappedBy="customerPartner"
      title="Customer Catalog Lines"/>
    <one-to-many name="complementaryProductList" title="Complementary product(s)"
      ref="com.axelor.apps.sale.db.ComplementaryProduct" mappedBy="partner"/>

    <!-- M1 - Conditions commerciales client -->
    <decimal name="remiseFacture" title="Remise/Fact. (%)" precision="5" scale="2" min="0"
      max="100"/>
    <decimal name="tauxRFA" title="RFA (%)" precision="5" scale="2" min="0" max="100"/>
    <!-- LVME : client « comptant » de GESCOM (paie à la commande, sans facilité de paiement) : filtre
      Client en compte / Client comptant de Listes Dossiers ; repris de GESCOM à la migration -->
    <boolean name="lvmeClientComptant" title="Client comptant"/>
    <!-- LVME : fournisseur Europe ou International (colonne « Type » de la liste Fournisseurs), saisi par le
      client sur la fiche ; liste lvme.partner.zone.select (PROD_112) -->
    <string name="lvmeZoneFournisseur" title="Type" selection="lvme.partner.zone.select"/>
    <!-- LVME : colonne « Contact » des listes Clients / Fournisseurs / Transporteurs GESCOM : premier
      contact du tiers -->
    <string name="lvmeContact" title="Contact" formula="true">
      <![CDATA[
      (SELECT min(base_partner.name) FROM base_partner WHERE base_partner.id IN (
        SELECT base_partner_contact_partner_set.contact_partner_set FROM base_partner_contact_partner_set
        WHERE base_partner_contact_partner_set.base_partner = id))
      ]]>
    </string>
    <!-- M3 - Frais de Commission -->
    <decimal name="tauxCommission" title="Taux Commission (%)" precision="5" scale="2"
      min="0" max="100"/>
    <many-to-one name="commercial" ref="com.axelor.auth.db.User" title="Commercial"/>
    <!-- LVME REC-009 : client sous contrat, ses réservations ne sont modifiables que par son commercial -->
    <boolean name="sousContrat" title="Sous contrat"/>
    <boolean name="portPaye" title="Port Payé"/>

    <!-- UC-01 - Rattachement groupement (spec VEN-020, VEN-021) -->
    <many-to-one name="groupement" ref="com.axelor.apps.sale.db.Groupement"
      title="Groupement" help="Groupement du client (Coditour, Relais d'Or, Système U...)"/>
    <string name="codeCoditour" title="Code Coditour"
      help="Identifiant du client chez Coditour (pour déclaration mensuelle de ristournes)"/>

  </entity>

</domain-models>
