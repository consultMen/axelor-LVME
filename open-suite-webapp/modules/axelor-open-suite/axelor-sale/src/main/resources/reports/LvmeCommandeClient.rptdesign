me="dataType">decimal</property></structure><structure><property name="position">38</property><property name="name">poids</property><property name="dataType">decimal</property></structure><structure><property name="position">39</property><property name="name">port_ht</property><property name="dataType">decimal</property></structure><structure><property name="position">40</property><property name="name">port_tva</property><property name="dataType">decimal</property></structure></list-property></structure><property name="dataSource">Data Source</property><list-property name="resultSet"><structure><property name="position">1</property><property name="name">sale_order_seq</property><property name="nativeName">sale_order_seq</property><property name="dataType">string</property></structure><structure><property name="position">2</property><property name="name">status_select</property><property name="nativeName">status_select</property><property name="dataType">integer</property></structure><structure><property name="position">3</property><property name="name">creation_date</property><property name="nativeName">creation_date</property><property name="dataType">date</property></structure><structure><property name="position">4</property><property name="name">estimated_delivery_date</property><property name="nativeName">estimated_delivery_date</property><property name="dataType">date</property></structure><structure><property name="position">5</property><property name="name">external_reference</property><property name="nativeName">external_reference</property><property name="dataType">string</property></structure><structure><property name="position">6</property><property name="name">internal_note</property><property name="nativeName">internal_note</property><property name="dataType">string</property></structure><structure><property name="position">7</property><property name="name">cout_port_kg</property><property name="nativeName">cout_port_kg</property><property name="dataType">decimal</property></structure><structure><property name="position">8</property><property name="name">port_paye</property><property name="nativeName">port_paye</property><property name="dataType">boolean</property></structure><structure><property name="position">9</property><property name="name">is_reservation</property><property name="nativeName">is_reservation</property><property name="dataType">boolean</property></structure><structure><property name="position">10</property><property name="name">remise_facture</property><property name="nativeName">remise_facture</property><property name="dataType">decimal</property></structure><structure><property name="position">11</property><property name="name">tauxrfa</property><property name="nativeName">tauxrfa</property><property name="dataType">decimal</property></structure><structure><property name="position">12</property><property name="name">lvme_frais_congelation</property><property name="nativeName">lvme_frais_congelation</property><property name="dataType">decimal</property></structure><structure><property name="position">13</property><property name="name">taux_commission</property><property name="nativeName">taux_commission</property><property name="dataType">decimal</property></structure><structure><property name="position">14</property><property name="name">ex_tax_total</property><property name="nativeName">ex_tax_total</property><property name="dataType">decimal</property></structure><structure><property name="position">15</property><property name="name">tax_total</property><property name="nativeName">tax_total</property><property name="dataType">decimal</property></structure><structure><property name="position">16</property><property name="name">in_tax_total</property><property name="nativeName">in_tax_total</property><property name="dataType">decimal</property></structure><structure><property name="position">17</property><property name="name">margin_rate</property><property name="nativeName">margin_rate</property><property name="dataType">decimal</property></structure><structure><property name="position">18</property><property name="name">total_gross_margin</property><property name="nativeName">total_gross_margin</property><property name="dataType">decimal</property></structure><structure><property name="position">19</property><property name="name">client_code</property><property name="nativeName">client_code</property><property name="dataType">string</property></structure><structure><property name="position">20</property><property name="name">client_nom</property><property name="nativeName">client_nom</property><property name="dataType">string</property></structure><structure><property name="position">21</property><property name="name">client_tel</property><property name="nativeName">client_tel</property><property name="dataType">string</property></structure><structure><property name="position">22</property><property name="name">address_l4</property><property name="nativeName">address_l4</property><property name="dataType">string</property></structure><structure><property name="position">23</property><property name="name">address_l5</property><property name="nativeName">address_l5</property><property name="dataType">string</property></structure><structure><property name="position">24</property><property name="name">zip</property><property name="nativeName">zip</property><property name="dataType">string</property></structure><structure><property name="position">25</property><property name="name">ville</property><property name="nativeName">ville</property><property name="dataType">string</property></structure><structure><property name="position">26</property><property name="name">pays</property><property name="nativeName">pays</property><property name="dataType">string</property></structure><structure><property name="position">27</property><property name="name">groupement</property><property name="nativeName">groupement</property><property name="dataType">string</property></structure><structure><property name="position">28</property><property name="name">commercial</property><property name="nativeName">commercial</property><property name="dataType">string</property></structure><structure><property name="position">29</property><property name="name">contact</property><property name="nativeName">contact</property><property name="dataType">string</property></structure><structure><property name="position">30</property><property name="name">reglement</property><property name="nativeName">reglement</property><property name="dataType">string</property></structure><structure><property name="position">31</property><property name="name">echeance</property><property name="nativeName">echeance</property><property name="dataType">string</property></structure><structure><property name="position">32</property><property name="name">operateur</property><property name="nativeName">operateur</property><property name="dataType">string</property></structure><structure><property name="position">33</property><property name="name">preparateur</property><property name="nativeName">preparateur</property><property name="dataType">string</property></structure><structure><property name="position">34</property><property name="name">transporteur</property><property name="nativeName">transporteur</property><property name="dataType">string</property></structure><structure><property name="position">35</property><property name="name">societe</property><property name="nativeName">societe</property><property name="dataType">string</property></structure><structure><property name="position">36</property><property name="name">logo_path</property><property name="nativeName">logo_path</property><property name="dataType">string</property></structure><structure><property name="position">37</property><property name="name">nb_colis</property><property name="nativeName">nb_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">38</property><property name="name">poids</property><property name="nativeName">poids</property><property name="dataType">decimal</property></structure><structure><property name="position">39</property><property name="name">port_ht</property><property name="nativeName">port_ht</property><property name="dataType">decimal</property></structure><structure><property name="position">40</property><property name="name">port_tva</property><property name="nativeName">port_tva</property><property name="dataType">decimal</property></structure></list-property><xml-property name="queryText"><![CDATA[SELECT so.sale_order_seq, so.status_select, so.creation_date, so.estimated_delivery_date, so.external_reference,
  so.internal_note, so.cout_port_kg, so.port_paye, so.is_reservation, so.remise_facture, so.tauxrfa,
  so.lvme_frais_congelation, so.taux_commission, so.ex_tax_total, so.tax_total, so.in_tax_total, so.margin_rate,
  so.total_gross_margin,
  cli.partner_seq AS client_code, COALESCE(cli.simple_full_name, cli.name) AS client_nom, cli.fixed_phone AS client_tel,
  adr.addressl4 AS address_l4, adr.addressl5 AS address_l5, adr.zip, city.name AS ville, pays.name AS pays,
  grp.name AS groupement, COALESCE(com_p.full_name, com_u.name) AS commercial, ctc.simple_full_name AS contact,
  pm.name AS reglement, pc.name AS echeance, COALESCE(op_p.full_name, op_u.name) AS operateur,
  COALESCE(prep_p.full_name, prep_u.name) AS preparateur, car.simple_full_name AS transporteur,
  co.name AS societe, logo.file_path AS logo_path,
  COALESCE(lig.nb_colis, 0) AS nb_colis, COALESCE(lig.poids, 0) AS poids,
  CASE WHEN so.port_paye THEN 0 ELSE COALESCE(lig.poids, 0) * COALESCE(so.cout_port_kg, 0) END AS port_ht,
  CASE WHEN so.port_paye THEN 0 ELSE COALESCE(lig.poids, 0) * COALESCE(so.cout_port_kg, 0) * 0.20 END AS port_tva
FROM sale_sale_order so
LEFT JOIN base_partner cli ON cli.id = so.client_partner
LEFT JOIN base_address adr ON adr.id = so.main_invoicing_address
LEFT JOIN base_city city ON city.id = adr.city
LEFT JOIN base_country pays ON pays.id = adr.country
LEFT JOIN sale_groupement grp ON grp.id = cli.groupement
LEFT JOIN auth_user com_u ON com_u.id = so.commercial
LEFT JOIN base_partner com_p ON com_p.id = com_u.partner
LEFT JOIN base_partner ctc ON ctc.id = so.contact_partner
LEFT JOIN account_payment_mode pm ON pm.id = so.payment_mode
LEFT JOIN account_payment_condition pc ON pc.id = so.payment_condition
LEFT JOIN auth_user op_u ON op_u.id = so.salesperson_user
LEFT JOIN base_partner op_p ON op_p.id = op_u.partner
LEFT JOIN auth_user prep_u ON prep_u.id = so.lvme_preparateur
LEFT JOIN base_partner prep_p ON prep_p.id = prep_u.partner
LEFT JOIN base_partner car ON car.id = so.carrier_partner
LEFT JOIN base_company co ON co.id = so.company
LEFT JOIN meta_file logo ON logo.id = co.logo
LEFT JOIN LATERAL (SELECT sum(l.nb_colis) AS nb_colis, sum(l.poids_total_net) AS poids
  FROM sale_sale_order_line l WHERE l.sale_order = so.id) lig ON true
WHERE so.id = ?]]></xml-property></oda-data-set><oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="LignesDS" id="1363"><list-property name="parameters"><structure><property name="name">param_1</property><property name="paramName">SaleOrderId</property><property name="dataType">decimal</property><property name="nativeDataType">-5</property><property name="position">1</property><property name="isInput">true</property><property name="isOutput">false</property></structure></list-property><structure name="cachedMetaData"><list-property name="resultSet"><structure><property name="position">1</property><property name="name">reference</property><property name="dataType">string</property></structure><structure><property name="position">2</property><property name="name">designation</property><property name="dataType">string</property></structure><structure><property name="position">3</property><property name="name">taux_tva</property><property name="dataType">string</property></structure><structure><property name="position">4</property><property name="name">arrivages</property><property name="dataType">string</property></structure><structure><property name="position">5</property><property name="name">fournisseurs</property><property name="dataType">string</property></structure><structure><property name="position">6</property><property name="name">origines</property><property name="dataType">string</property></structure><structure><property name="position">7</property><property name="name">frigos</property><property name="dataType">string</property></structure><structure><property name="position">8</property><property name="name">date_livraison</property><property name="dataType">date</property></structure><structure><property name="position">9</property><property name="name">lots</property><property name="dataType">string</property></structure><structure><property name="position">10</property><property name="name">ddm</property><property name="dataType">date</property></structure><structure><property name="position">11</property><property name="name">nb_unites_par_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">12</property><property name="name">prix_achat</property><property name="dataType">decimal</property></structure><structure><property name="position">13</property><property name="name">colis_rsv</property><property name="dataType">decimal</property></structure><structure><property name="position">14</property><property name="name">colis_dispo</property><property name="dataType">decimal</property></structure><structure><property name="position">15</property><property name="name">nb_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">16</property><property name="name">unite</property><property name="dataType">string</property></structure><structure><property name="position">17</property><property name="name">poids_total_net</property><property name="dataType">decimal</property></structure><structure><property name="position">18</property><property name="name">qty</property><property name="dataType">decimal</property></structure><structure><property name="position">19</property><property name="name">prix_revient</property><property name="dataType">decimal</property></structure><structure><property name="position">20</property><property name="name">price_discounted</property><property name="dataType">decimal</property></structure><structure><property name="position">21</property><property name="name">lvme_promo</property><property name="dataType">boolean</property></structure><structure><property name="position">22</property><property name="name">ex_tax_total</property><property name="dataType">decimal</property></structure><structure><property name="position">23</property><property name="name">sub_margin_rate</property><property name="dataType">decimal</property></structure><structure><property name="position">24</property><property name="name">sub_total_gross_margin</property><property name="dataType">decimal</property></structure></list-property></structure><property name="dataSource">Data Source</property><list-property name="resultSet"><structure><property name="position">1</property><property name="name">reference</property><property name="nativeName">reference</property><property name="dataType">string</property></structure><structure><property name="position">2</property><property name="name">designation</property><property name="nativeName">designation</property><property name="dataType">string</property></structure><structure><property name="position">3</property><property name="name">taux_tva</property><property name="nativeName">taux_tva</property><property name="dataType">string</property></structure><structure><property name="position">4</property><property name="name">arrivages</property><property name="nativeName">arrivages</property><property name="dataType">string</property></structure><structure><property name="position">5</property><property name="name">fournisseurs</property><property name="nativeName">fournisseurs</property><property name="dataType">string</property></structure><structure><property name="position">6</property><property name="name">origines</property><property name="nativeName">origines</property><property name="dataType">string</property></structure><structure><property name="position">7</property><property name="name">frigos</property><property name="nativeName">frigos</property><property name="dataType">string</property></structure><structure><property name="position">8</property><property name="name">date_livraison</property><property name="nativeName">date_livraison</property><property name="dataType">date</property></structure><structure><property name="position">9</property><property name="name">lots</property><property name="nativeName">lots</property><property name="dataType">string</property></structure><structure><property name="position">10</property><property name="name">ddm</property><property name="nativeName">ddm</property><property name="dataType">date</property></structure><structure><property name="position">11</property><property name="name">nb_unites_par_colis</property><property name="nativeName">nb_unites_par_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">12</property><property name="name">prix_achat</property><property name="nativeName">prix_achat</property><property name="dataType">decimal</property></structure><structure><property name="position">13</property><property name="name">colis_rsv</property><property name="nativeName">colis_rsv</property><property name="dataType">decimal</property></structure><structure><property name="position">14</property><property name="name">colis_dispo</property><property name="nativeName">colis_dispo</property><property name="dataType">decimal</property></structure><structure><property name="position">15</property><property name="name">nb_colis</property><property name="nativeName">nb_colis</property><property name="dataType">decimal</property></structure><structure><property name="position">16</property><property name="name">unite</property><property name="nativeName">unite</property><property name="dataType">string</property></structure><structure><property name="position">17</property><property name="name">poids_total_net</property><property name="nativeName">poids_total_net</property><property name="dataType">decimal</property></structure><structure><property name="position">18</property><property name="name">qty</property><property name="nativeName">qty</property><property name="dataType">decimal</property></structure><structure><property name="position">19</property><property name="name">prix_revient</property><property name="nativeName">prix_revient</property><property name="dataType">decimal</property></structure><structure><property name="position">20</property><property name="name">price_discounted</property><property name="nativeName">price_discounted</property><property name="dataType">decimal</property></structure><structure><property name="position">21</property><property name="name">lvme_promo</property><property name="nativeName">lvme_promo</property><property name="dataType">boolean</property></structure><structure><property name="position">22</property><property name="name">ex_tax_total</property><property name="nativeName">ex_tax_total</property><property name="dataType">decimal</property></structure><structure><property name="position">23</property><property name="name">sub_margin_rate</property><property name="nativeName">sub_margin_rate</property><property name="dataType">decimal</property></structure><structure><property name="position">24</property><property name="name">sub_total_gross_margin</property><property name="nativeName">sub_total_gross_margin</property><property name="dataType">decimal</property></structure></list-property><xml-property name="queryText"><![CDATA[SELECT p.code AS reference, l.product_name AS designation,
  (SELECT string_agg(DISTINCT replace(to_char(tl.value, 'FM990.00'), '.', ','), ', ') FROM sale_sale_order_line_tax_line_set s
    JOIN account_tax_line tl ON tl.id = s.tax_line_set WHERE s.sale_sale_order_line = l.id) AS taux_tva,
  lot.arrivages, lot.fournisseurs, lot.origines, lot.frigos, l.estimated_delivery_date AS date_livraison, lot.lots,
  lot.ddm, l.nb_unites_par_colis, lot.prix_achat, es.colis_rsv, es.colis_dispo, l.nb_colis, u.name AS unite,
  l.poids_total_net, l.qty, l.prix_revient, l.price_discounted, l.lvme_promo, l.ex_tax_total, l.sub_margin_rate,
  l.sub_total_gross_margin
FROM sale_sale_order_line l
LEFT JOIN base_product p ON p.id = l.product
LEFT JOIN base_unit u ON u.id = l.unit
LEFT JOIN LATERAL (
  SELECT string_agg(DISTINCT sm.stock_move_seq, ', ') AS arrivages, string_agg(DISTINCT pa.partner_seq, ', ') AS fournisseurs,
    string_agg(DISTINCT sml.origine, ', ') AS origines, string_agg(DISTINCT loc.name, ', ') AS frigos,
    string_agg(DISTINCT t.tracking_number_seq, ', ') AS lots, min(sml.dluo) AS ddm,
    round(max(sml.unit_price_untaxed), 4) AS prix_achat
  FROM supplychain_sale_order_line_lot x
  JOIN stock_tracking_number t ON t.id = x.tracking_number
  LEFT JOIN stock_stock_move_line sml ON sml.id = t.origin_stock_move_line
  LEFT JOIN stock_stock_move sm ON sm.id = sml.stock_move
  LEFT JOIN base_partner pa ON pa.id = sm.partner
  LEFT JOIN stock_stock_location loc ON loc.id = sml.to_stock_location
  WHERE x.sale_order_line = l.id) lot ON true
LEFT JOIN LATERAL (
  SELECT round(COALESCE(sum(e.nb_colis_cdes), 0), 3) AS colis_rsv,
    round(COALESCE(sum(e.nb_colis_stock - e.nb_colis_cdes), 0), 3) AS colis_dispo
  FROM lvme_etat_stock_lot e
  WHERE e.tracking_number_id IN (SELECT x.tracking_number FROM supplychain_sale_order_line_lot x
    WHERE x.sale_order_line = l.id)) es ON true
WHERE l.sale_order = ?
ORDER BY l.sequence, l.id]]></xml-property></oda-data-set></data-sets><page-setup><simple-master-page name="Simple MasterPage" id="2"><property name="type">a4</property><property name="orientation">landscape</property><property name="topMargin">0.8cm</property><property name="leftMargin">0.8cm</property><property name="bottomMargin">0.8cm</property><property name="rightMargin">0.8cm</property><page-footer><grid id="1364"><property name="width">100%</property><column id="1365"/><row id="1366"><cell id="1367"><auto-text id="1368"><property name="fontSize">7pt</property><property name="textAlign">right</property><property name="type">page-number</property></auto-text></cell></row></grid></page-footer></simple-master-page></page-setup><list-property name="images"><structure><property name="name">lvme-logo.png</property><property name="type">image/png</property><property name="data"></property></structure></list-property><body><list id="1202"><property name="dataSet">EnteteDS</property><list-property name="boundDataColumns"><structure><property name="name">sale_order_seq</property><expression name="expression" type="javascript">dataSetRow["sale_order_seq"]</expression><property name="dataType">string</property></structure><structure><property name="name">status_select</property><expression name="expression" type="javascript">dataSetRow["status_select"]</expression><property name="dataType">integer</property></structure><structure><property name="name">creation_date</property><expression name="expression" type="javascript">dataSetRow["creation_date"]</expression><property name="dataType">date</property></structure><structure><property name="name">estimated_delivery_date</property><expression name="expression" type="javascript">dataSetRow["estimated_delivery_date"]</expression><property name="dataType">date</property></structure><structure><property name="name">external_reference</property><expression name="expression" type="javascript">dataSetRow["external_reference"]</ex