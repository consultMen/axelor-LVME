        <field name="axis3AnalyticAccount" readonlyIf="analyticDistributionTemplate != null" onChange="action-sale-order-line-method-axis-create-analytic-line" onSelect="action-sale-order-line-method-set-axis-domain" form-view="analytic-account-form" grid-view="analytic-account-grid"/>
