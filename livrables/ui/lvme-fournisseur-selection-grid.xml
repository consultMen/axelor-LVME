       commande d'achat, arrivage) au lieu de la liste Axelor ; mêmes colonnes que la liste du menu Fournisseurs -->
  <field name="partnerSeq" title="Référence" width="110"/>
  <field name="name" title="Nom" width="260"/>
  <field name="lvmeZoneFournisseur" title="Type" width="110"/>
  <field name="lvmeContact" title="Contact" width="150"/>
  <field name="fixedPhone" title="Téléphone" width="120"/>
  <field name="mobilePhone" title="Portable" width="120"/>
  <field name="mainAddress.zip" title="Code Postal" width="90"/>
  <field name="mainAddress.townName" title="Ville" width="140"/>
  <field name="mainAddress.country" title="Pays" width="110"/>
</grid>
