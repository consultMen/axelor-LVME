<form name="lvme-transporteur-search-form" title="Transporteurs" model="com.axelor.utils.db.Wizard" width="large"
  canNew="false" canSave="false" canCopy="false" canDelete="false" onNew="action-lvme-recherche-defaults">
  <!-- LVME : écran « Transporteurs » comme les listes Clients / Fournisseurs GESCOM : « Recherche rapide par » + liste
       (repère css="lvme-ges-art" : présentation GESCOM sur un seul écran) -->
  <panel name="rechercheRapidePanel" title="Recherche" colSpan="12">
    <field name="$critere" title="Recherche rapide par" type="integer" selection="lvme.recherche.transporteur.select" colSpan="3" css="lvme-ges-art"/>
    <field name="$valeur" showTitle="false" type="string" colSpan="5" onChange="action-lvme-recherche-refresh"/>
    <button name="rechercheBtn" title="Recherche" icon="search" css="btn-primary" colSpan="2" onClick="action-lvme-recherche-refresh"/>
    <button name="nouveauBtn" title="Nouveau transporteur" icon="plus" colSpan="2" onClick="action-lvme-transporteur-new"/>
    <field name="$archives" title="Archivés" type="boolean" colSpan="8" onChange="action-lvme-recherche-refresh"/>
    <button colSpan="4" name="lvmeArchivageBtn" title="Archiver / Désarchiver" icon="archive" onClick="action-lvme-transporteur-dashlet"/>
  </panel>
  <panel-dashlet canDelete="true" name="listeDashlet" title="Transporteurs" colSpan="12" height="650" action="action-lvme-transporteur-dashlet"/>
</form>
