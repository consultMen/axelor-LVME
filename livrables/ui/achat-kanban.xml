<kanban name="lvme-achat-kanban" title="Commandes d'achat" model="com.axelor.apps.purchase.db.PurchaseOrder"
  columnBy="lvmeEtapeAchat" sequenceBy="lvmeKanbanSeq" orderBy="estimatedReceiptDate" onMove="action-lvme-kanban-deplacer-achat" limit="30">
  <!-- LVME : commandes d'achat en colonnes par étape (Brouillon, À embarquer, Flottant, En stock,
       Annulée) ; déplacer une carte valide ou annule la commande ; carte rouge si la réception
       prévue est dépassée -->
  <field name="purchaseOrderSeq"/>
  <field name="supplierPartner"/>
  <field name="orderDate"/>
  <field name="estimatedReceiptDate"/>
  <field name="exTaxTotal"/>
  <field name="currency"/>
  <field name="shipmentMode"/>
  <field name="lvmeEnRetard"/>
  <field name="lvmeEtapeAchat"/>
  <hilite color="danger" if="lvmeEnRetard"/>
  <template><![CDATA[
    <>
      <Box style={{ borderLeft: '6px solid ' + ({1: '#6c757d', 2: '#fd7e14', 3: '#0dcaf0', 4: '#198754', 5: '#dc3545'})[lvmeEtapeAchat], borderRadius: 8, padding: '6px 10px',
        background: lvmeEnRetard ? '#fff1f1' : 'transparent' }}>
        <Box d="flex" style={{ justifyContent: 'space-between', alignItems: 'center', gap: 6 }}>
          <Box style={{ fontSize: 15, fontWeight: 800, color: '#0a3d91' }}>{purchaseOrderSeq}</Box>
          {lvmeEnRetard && <Badge bg="danger">⏰ En retard</Badge>}
        </Box>
        <Box style={{ fontWeight: 600, color: '#1b2a4a', margin: '2px 0 6px' }}>{$fmt('supplierPartner')}</Box>
        {shipmentMode && <Box style={{ display: 'inline-block', background: '#e7f1ff', color: '#0a3d91', borderRadius: 10,
          padding: '1px 8px', fontSize: 12, fontWeight: 600, marginBottom: 6 }}>{(shipmentMode.name == 'Bateau' ? '🚢 ' : '🚚 ') + $fmt('shipmentMode')}</Box>}
        <Box style={{ fontSize: 12, color: '#555' }}>📝 Commande : <b>{$fmt('orderDate')}</b></Box>
        <Box style={{ fontSize: 12, color: '#555' }}>📅 Réception : <b>{$fmt('estimatedReceiptDate')}</b></Box>
        <Box style={{ textAlign: 'right', marginTop: 6, fontWeight: 800, fontSize: 13, color: '#0d6b3d' }}>{$fmt('exTaxTotal')} {$fmt('currency')}</Box>
      </Box>
  
    </>
  ]]></template>
</kanban>
