<form name="lvme-historique-prix-form" title="Historique prix" model="com.axelor.utils.db.Wizard" width="large"
  canNew="false" canSave="false" canCopy="false" canDelete="false" onNew="action-lvme-cdes-client-lignes-group-onnew">
  <!-- LVME : écran « Historique prix » GESCOM (F1 de la ligne de commande client) : période, client et produit de
       la ligne, puis les ventes passées sur un seul écran -->
  <panel name="histoFiltresPanel" showTitle="false" colSpan="12">
    <panel name="histoPeriodePanel" colSpan="4" itemSpan="6" css="lvme-histo-filtres">
      <field name="$dateDu" title="Période du" type="date"/>
      <field name="$dateAu" title="au" type="date"/>
      <field name="$datePeriode" title="Période prédéfinie" type="integer" selection="lvme.etat.stock.periode.select"
        colSpan="12" onChange="action-lvme-cde-client-periode-date"/>
    </panel>
    <panel name="histoClientPanel" colSpan="6" itemSpan="12" css="lvme-histo-filtres">
      <field name="$client" grid-view="lvme-client-selection-grid" title="Client" type="many-to-one" target="com.axelor.apps.base.db.Partner"
        domain="self.isCustomer = true" canNew="false" canEdit="false" canView="false"/>
      <field name="$produit" title="Produit" type="many-to-one" target="com.axelor.apps.base.db.Product"
        canNew="false" canEdit="false" canView="false"/>
    </panel>
    <panel name="histoRecherchePanel" colSpan="2" itemSpan="12" css="lvme-histo-filtres">
      <button name="rechercheBtn" title="Recherche" icon="search" onClick="action-lvme-cdes-client-lignes-refresh"/>
      <button colSpan="8" name="imprimerBtn" title="Imprimer" icon="printer" onClick="action-lvme-historique-prix-imprimer"/>
    <button name="imprimerBtnExcel" title="Excel" icon="file-earmark-excel" css="btn-success" colSpan="4" onClick="action-lvme-historique-prix-imprimer-excel"/>
    </panel>
  </panel>
  <panel-dashlet name="lignesDashlet" title="Historique prix" colSpan="12" height="500"
    action="action-lvme-historique-prix-dashlet"/>
</form>
