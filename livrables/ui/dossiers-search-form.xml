<form name="lvme-dossiers-search-form" title="Listes Dossiers" model="com.axelor.utils.db.Wizard" width="large"
  canNew="false" canSave="false" canCopy="false" canDelete="false" onNew="action-lvme-dossiers-group-onnew">
  <!-- LVME REC-012 : écran « Listes Dossiers » de GESCOM (BL / BL retour, Facture / Avoir) + vue transporteur, sur un
       seul écran comme GESCOM (cadre Type doc css="lvme-ges-dossiers") : cadre Recherche, boutons à droite,
       recherche directe par N° sous le cadre -->
  <panel name="rechercheDossiersPanel" title="Recherche" colSpan="9">
    <panel name="filtreTypePanel" colSpan="4" itemSpan="12" css="lvme-ges-dossiers">
      <field name="$typeDoc" title="Type doc" type="integer" selection="lvme.dossier.type.select" onChange="action-lvme-dossiers-refresh"/>
      <field name="$client" title="Client" type="many-to-one" target="com.axelor.apps.base.db.Partner"
        domain="self.isCustomer = true" canNew="false" canEdit="false" canView="false"/>
      <field name="$transporteur" title="Transporteur" type="many-to-one" target="com.axelor.apps.base.db.Partner"
        domain="self.isCarrier = true OR self.id IN (SELECT sm.carrierPartner.id FROM StockMove sm WHERE sm.carrierPartner IS NOT NULL)" canNew="false" canEdit="false" canView="false" showIf="$typeDoc != 2"/>
    </panel>
    <panel name="filtreLivraisonPanel" colSpan="4" itemSpan="12">
      <field name="$livraisonDu" title="Livraison du" type="date"/>
      <field name="$livraisonAu" title="au" type="date"/>
      <field name="$livraisonPeriode" title="Période prédéfinie" type="integer" selection="lvme.etat.stock.periode.select"
        onChange="action-lvme-dossiers-group-periode"/>
    </panel>
    <panel name="filtreFacturePanel" colSpan="4" itemSpan="12">
      <field name="$blFacture" showTitle="false" type="integer" widget="RadioSelect" selection="lvme.dossier.facture.select"
        showIf="$typeDoc != 2" onChange="action-lvme-dossiers-refresh"/>
      <field name="$detailProduits" title="Détail produits" type="boolean" showIf="$typeDoc != 2" onChange="action-lvme-dossiers-refresh"/>
      <button name="lancerRechercheBtn" title="Lancer la recherche" icon="search" onClick="action-lvme-dossiers-refresh"/>
    </panel>
  </panel>
  <panel name="boutonsDossiersPanel" showTitle="false" colSpan="3" itemSpan="12">
    <button name="quitterBtn" title="Quitter" icon="x-circle" onClick="close"/>
    <button name="nouveauBlBtn" title="Nouveau BL" icon="file-earmark-plus" onClick="action-lvme-dossiers-nouveau-bl"/>
    <button name="nouveauRetourBtn" title="Nouveau retour" icon="file-earmark-plus" onClick="action-lvme-dossiers-nouveau-retour"/>
    <button name="suppressionBtn" title="Suppression" icon="dash-circle" onClick="action-lvme-dossiers-suppression"/>
  </panel>
  <panel name="rechercheNumeroPanel" showTitle="false" colSpan="12">
    <field name="$numero" title="Recherche direct par N°" type="string" colSpan="4" onChange="action-lvme-dossiers-refresh"/>
  </panel>
  <panel-dashlet name="blDashlet" title="BL / BL retour" showTitle="false" colSpan="12" height="600"
    action="action-lvme-dossiers-bl-dashlet" showIf="$typeDoc != 2 &amp;&amp; !$detailProduits"/>
  <panel-dashlet name="lignesDashlet" title="Détail produits des BL" showTitle="false" colSpan="12" height="600"
    action="action-lvme-dossiers-lignes-dashlet" showIf="$typeDoc != 2 &amp;&amp; $detailProduits"/>
  <panel-dashlet name="facturesDashlet" title="Facture / Avoir" showTitle="false" colSpan="12" height="600"
    action="action-lvme-dossiers-factures-dashlet" showIf="$typeDoc == 2"/>
</form>
