<form name="lvme-article-search-form" title="Articles" model="com.axelor.utils.db.Wizard" width="large"
  canNew="false" canSave="false" canCopy="false" canDelete="false" onNew="action-lvme-recherche-defaults">
  <!-- LVME : écran « Articles » de GESCOM : « Recherche rapide par » + liste -->
  <panel name="rechercheRapidePanel" title="Recherche" colSpan="12">
    <field name="$critere" title="Recherche rapide par" type="integer" selection="lvme.recherche.article.select" colSpan="3"/>
    <field name="$valeur" showTitle="false" type="string" colSpan="3" onChange="action-lvme-recherche-refresh"/>
    <button name="rechercheBtn" title="Recherche" icon="search" css="btn-primary" colSpan="2" onClick="action-lvme-recherche-refresh"/>
    <button name="rechercheAvanceeBtn" title="Recherche avancée" icon="funnel" colSpan="2" onClick="sc.root.sale.products"/>
    <button name="nouveauBtn" title="Nouvel article" icon="plus" colSpan="2" onClick="action-lvme-article-new"/>
    <field name="$archives" title="Archivés" type="boolean" colSpan="2" onChange="action-lvme-recherche-refresh"/>
    <button colSpan="3" name="lvmeArchivageBtn" title="Archiver / Désarchiver" icon="archive" onClick="action-lvme-article-dashlet"/>
  </panel>
  <panel-dashlet name="listeDashlet" title="Articles" colSpan="12" height="650" action="action-lvme-article-dashlet"/>
</form>
