<grid name="lvme-selection-arrivage-grid" title="Sélection Arrivage" model="com.axelor.apps.supplychain.db.EtatStockLot"
  orderBy="arrivalDate,arrivalNumber" canNew="false" canEdit="false" canDelete="false" css="lvme-gescom-liste">
  <!-- LVME : « Sélection Arrivage » GESCOM (bouton Sélect Arrivage de la ligne de commande client) : un arrivage /
       lot de l'article par ligne ; le lot choisi est ajouté aux lots sélectionnés de la ligne -->
  <field name="arrivalNumber" title="Numero Arrivage" width="90"/>
  <field name="supplierName" title="Fournisseur" width="150"/>
  <field name="origine" title="Origine" width="90"/>
  <field name="conditionnement" title="Conditionnement" width="120"/>
  <field name="stockLocation" title="Frigo" width="90"/>
  <field name="lotNumber" title="N° Lot" width="110"/>
  <field name="arrivalDate" title="Date Arrivée" width="90"/>
  <field name="dluo" title="D.D.M" width="90"/>
  <field name="unit" title="Unité Vente" width="90"/>
  <field name="prixRevient" title="Prix Revient" x-scale="2" width="75"/>
  <field name="qtyPerColis" title="Poids Colis" x-scale="0" width="65"/>
  <field name="nbColisStock" title="Colis Stock" x-scale="0" width="65"/>
  <field name="nbColisCdes" title="Colis Rsv" x-scale="0" width="65"/>
  <field name="dispoQty" title="Poids Dispo" x-scale="0" width="75"/>
  <field name="nbColisDispo" title="Colis Dispo" x-scale="0" width="70">
    <hilite background="warning" if="true"/>
  </field>
</grid>
