<kanban name="lvme-arrivage-kanban" title="Arrivages" model="com.axelor.apps.stock.db.StockMove" columnBy="lvmeEtapeArrivage"
  sequenceBy="lvmeKanbanSeq" orderBy="estimatedDate" onMove="action-lvme-kanban-deplacer-arrivage" limit="30">
  <!-- LVME : arrivages en colonnes par étape (Brouillon, À embarquer, Flottant, Réel, Annulé) ; déplacer une carte
       lance l'action de la fiche (Réel / Annulé : ouvre la fiche) ; carte rouge si l'arrivée prévue est dépassée -->
  <field name="stockMoveSeq"/>
  <field name="partner"/>
  <field name="shipmentMode"/>
  <field name="bateau"/>
  <field name="estimatedDate"/>
  <field name="nbColisTotal"/>
  <field name="poidsTotal"/>
  <field name="exTaxTotal"/>
  <field name="lvmeEnRetard"/>
  <field name="lvmeEtapeArrivage"/>
  <hilite color="danger" if="lvmeEnRetard"/>
  <template><![CDATA[
    <Box style={{ borderLeft: '6px solid ' + ({0: '#6c757d', 1: '#fd7e14', 2: '#0dcaf0', 3: '#198754', 4: '#dc3545'})[lvmeEtapeArrivage], borderRadius: 8, padding: '6px 10px',
      background: lvmeEnRetard ? '#fff1f1' : 'transparent' }}>
      <Box d="flex" style={{ justifyContent: 'space-between', alignItems: 'center', gap: 6 }}>
        <Box style={{ fontSize: 15, fontWeight: 800, color: '#0a3d91' }}>{stockMoveSeq}</Box>
        {lvmeEnRetard && <Badge bg="danger">⏰ En retard</Badge>}
      </Box>
      <Box style={{ fontWeight: 600, color: '#1b2a4a', margin: '2px 0 6px' }}>{$fmt('partner')}</Box>
      <Box d="flex" style={{ gap: 6, flexWrap: 'wrap', marginBottom: 6 }}>
        {shipmentMode && <Box style={{ background: '#e7f1ff', color: '#0a3d91', borderRadius: 10, padding: '1px 8px', fontSize: 12, fontWeight: 600 }}>
          {(shipmentMode.name == 'Bateau' ? '🚢 ' : '🚚 ') + $fmt('shipmentMode')}</Box>}
        {bateau && <Box style={{ background: '#e6f7fa', color: '#0b5f6d', borderRadius: 10, padding: '1px 8px', fontSize: 12 }}>⚓ {$fmt('bateau')}</Box>}
      </Box>
      <Box style={{ fontSize: 12, color: '#555' }}>📅 Arrivée prévue : <b>{$fmt('estimatedDate')}</b></Box>
      <Box d="flex" style={{ justifyContent: 'space-between', alignItems: 'center', marginTop: 6, fontSize: 12, color: '#333' }}>
        <Box>📦 {$fmt('nbColisTotal')} · ⚖ {$fmt('poidsTotal')} kg</Box>
        <Box style={{ fontWeight: 800, fontSize: 13, color: '#0d6b3d' }}>{$fmt('exTaxTotal')} €</Box>
      </Box>
    </Box>
  ]]></template>
</kanban>
