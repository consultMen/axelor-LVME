<grid name="lvme-incoherence-grid" title="Incohérences" model="com.axelor.apps.supplychain.db.Incoherence"
  orderBy="typeEcart,-dateDoc,orderRef" canNew="false" canEdit="false" canDelete="false">
  <!-- LVME REC-012 : rapport d'incohérences Commandes VS Réceptions VS BL VS Facturé ; colonnes aux libellés
       GESCOM, écart et prix facturé différent en rouge (lignes blanc / gris : css/lvme.css) -->
  <field name="typeLabel" title="Type d'écart" width="200"/>
  <field name="orderRef" title="N° Pièce" width="85"/>
  <field name="dateDoc" title="Date" width="85"/>
  <field name="partner" title="Tiers" width="170"/>
  <field name="product" title="Produit" width="105"/>
  <field name="productName" title="Désignation" width="190"/>
  <field name="qtyCde" title="Qté Cde" x-scale="2" width="75"/>
  <field name="qtyMvt" title="Qté Livrée / Reçue" x-scale="2" width="85"/>
  <field name="qtyFacturee" title="Qté Facturée" x-scale="2" width="80"/>
  <field name="ecart" title="Écart" x-scale="2" width="75">
    <hilite color="danger" strong="true" if="ecart != 0"/>
  </field>
  <field name="colisCde" title="Colis Cde" x-scale="0" width="65"/>
  <field name="colisMvt" title="Colis Reçus" x-scale="0" width="65"/>
  <field name="prixCde" title="Prix Cde" x-scale="2" width="70"/>
  <field name="prixFacture" title="Prix Facturé" x-scale="2" width="75">
    <hilite color="danger" strong="true" if="prixFacture != null &amp;&amp; prixFacture != prixCde"/>
  </field>
  <field name="mvtNumeros" title="N° BL / Réception" width="110"/>
  <field name="factureNumeros" title="N° Facture" width="95"/>
</grid>
