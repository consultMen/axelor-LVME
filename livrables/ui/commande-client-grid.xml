<grid name="lvme-commande-client-grid" title="Commandes clients" model="com.axelor.apps.sale.db.SaleOrder" orderBy="-orderDate,-id" canNew="false">
  <!-- LVME : colonnes de « Listes Commandes Clients » GESCOM -->
  <hilite color="danger" if="totalGrossMargin &lt; 0"/>
  <field name="saleOrderSeq" title="N° Commande" width="110"/>
  <field name="orderDate" title="Date" width="95"/>
  <field name="clientPartner.name" title="Client" width="220"/>
  <field name="clientPartner.partnerSeq" title="Code" width="90"/>
  <field name="mainInvoicingAddress.city" title="Ville" width="120"/>
  <field name="clientPartner.fixedPhone" title="Téléphone" width="110"/>
  <field name="exTaxTotal" title="Montant HT" aggregate="sum" width="110"/>
  <field name="totalGrossMargin" title="Marge ht" aggregate="sum" width="100"/>
  <field name="marginRate" title="% Marge" width="80"/>
  <field name="commercial" title="Commercial" width="110"/>
  <field name="contactPartner" title="Nom responsable" width="140"/>
  <field name="estimatedDeliveryDate" title="Date livraison" width="100"/>
  <field name="deliveryState" title="Livraison" width="100"/>
  <field name="externalReference" title="Ref Cde Client" width="120"/>
  <field name="statusSelect" hidden="true"/>
</grid>
