<form name="lvme-etat-stock-lot-search-form" title="État des stocks par lots"

  model="com.axelor.utils.db.Wizard" width="large" canNew="false" canSave="false" canCopy="false" canDelete="false"

  onNew="action-lvme-etat-stock-lot-group-onnew">

  <!-- LVME : bandeau d'alerte DLUO -->

  <panel name="alertesDluoPanel" showTitle="false" colSpan="12" css="lvme-ges-etat">

    <field name="$nbDluoDepassee" type="integer" hidden="true"/>

    <field name="$nbDluoProche" type="integer" hidden="true"/>

    <field name="$alerteDluo" showTitle="false" readonly="true" colSpan="12" type="string">

      <viewer depends="$nbDluoDepassee,$nbDluoProche"><![CDATA[

        <>

          {$nbDluoDepassee > 0 && <Badge bg="danger">{$nbDluoDepassee} lot(s) en stock avec DLUO dépassée (lignes rouges)</Badge>}

          {' '}

          {$nbDluoProche > 0 && <Badge bg="warning">{$nbDluoProche} lot(s) avec DLUO dans moins de 30 jours (lignes orange)</Badge>}

          {!($nbDluoDepassee > 0) && !($nbDluoProche > 0) && <Badge bg="success">Aucun lot en stock avec DLUO dépassée ou proche</Badge>}

        </>

      ]]></viewer>

    </field>

  <button name="voirPerimesBtn" title="Voir les lots périmés" css="btn-danger" colSpan="3" icon="exclamation-triangle" showIf="$nbDluoDepassee &gt; 0" onClick="action-lvme-etat-stock-lot-group-dluo-perimes"/>
    <button name="voirDluoProcheBtn" title="Voir les lots à DLUO proche" css="btn-warning" colSpan="3" icon="clock" showIf="$nbDluoProche &gt; 0" onClick="action-lvme-etat-stock-lot-group-dluo-proche"/>
    <!-- les deux à la fois : périmés (rouge) + DLUO dans moins de 30 jours (orange) -->
    <button name="voirDluoTousBtn" title="Voir périmés + DLUO proche" css="btn-secondary" colSpan="3" icon="exclamation-diamond" showIf="$nbDluoDepassee &gt; 0 &amp;&amp; $nbDluoProche &gt; 0" onClick="action-lvme-etat-stock-lot-group-dluo-tous"/>
  </panel>

  <panel name="filtresPanel" showTitle="false" colSpan="12" css="lvme-ges-etat">

    <panel name="filtreArticlePanel" colSpan="3" itemSpan="12">

      <field name="$articleDu" title="Article du" type="many-to-one" target="com.axelor.apps.base.db.Product" canNew="false" canEdit="false" canView="false"/>

      <field name="$articleAu" title="au" type="many-to-one" target="com.axelor.apps.base.db.Product" canNew="false" canEdit="false" canView="false"/>

      <field name="$famille" title="Fam. article" type="many-to-one" target="com.axelor.apps.base.db.ProductCategory" canNew="false" canEdit="false" canView="false"/>

      <field name="$numeroLot" title="OU Lot n°" type="string" onChange="action-lvme-etat-stock-lot-refresh"/>

    </panel>

    <panel name="filtreFournisseurPanel" colSpan="3" itemSpan="12">

      <field name="$fournisseurDu" grid-view="lvme-fournisseur-selection-grid" title="Fournisseur du" type="many-to-one" target="com.axelor.apps.base.db.Partner" domain="self.isSupplier = true" canNew="false" canEdit="false" canView="false"/>

      <field name="$fournisseurAu" grid-view="lvme-fournisseur-selection-grid" title="au" type="many-to-one" target="com.axelor.apps.base.db.Partner" domain="self.isSupplier = true" canNew="false" canEdit="false" canView="false"/>

      <field name="$origine" title="Origine" type="string" selection="lvme.origine.select"/>

      <field name="$frigo" title="Frigo" type="many-to-one" target="com.axelor.apps.stock.db.StockLocation" domain="self.typeSelect = 1" canNew="false" canEdit="false" canView="false"/>

    </panel>

    <panel name="filtreDatesPanel" colSpan="4" itemSpan="4" css="lvme-ges-dates-jaune">

      <field name="$entreeDu" title="Entrée du" type="date"/>

      <field name="$entreeAu" title="au" type="date"/>

      <field name="$entreePeriode" title="Période prédéfinie" type="integer" selection="lvme.etat.stock.periode.select" onChange="action-lvme-etat-stock-lot-periode-entree"/>

      <field name="$ddmDu" title="D.D.M. du" type="date"/>

      <field name="$ddmAu" title="au" type="date"/>

      <field name="$ddmPeriode" title="Période prédéfinie" type="integer" selection="lvme.etat.stock.periode.select" onChange="action-lvme-etat-stock-lot-periode-ddm"/>

      <field name="$livrDu" title="Livr. du" type="date"/>

      <field name="$livrAu" title="au" type="date"/>

      <field name="$livrPeriode" title="Période prédéfinie" type="integer" selection="lvme.etat.stock.periode.select" onChange="action-lvme-etat-stock-lot-periode-livr"/>

    </panel>

    <panel name="filtreOptionsPanel" colSpan="2" itemSpan="12" css="lvme-ges-cadre">
      <field name="$natureArrivage" title="Arrivage" type="integer" widget="RadioSelect" selection="lvme.etat.stock.nature.select"/>
      <field name="$etatLot" title="Lots" type="integer" widget="RadioSelect" selection="lvme.etat.stock.etat.select"/>
      <field name="$dluoFiltre" title="DLUO" type="integer" widget="RadioSelect" selection="lvme.etat.stock.dluo.select"/>
      <field name="$dispoNegatif" title="Seulement les dispo négatifs" type="boolean"/>
      <button name="lancerRechercheBtn" title="Lancer la recherche" icon="search" css="btn-primary" onClick="action-lvme-etat-stock-lot-refresh"/>
      <button name="lvmeArchivageBtn" title="Archiver / Désarchiver" icon="archive" onClick="action-lvme-etat-stock-lot-dashlet"/>
    </panel>

  </panel>

  <panel-dashlet name="lotsDashlet" title="Lots" colSpan="12" height="600"

    action="action-lvme-etat-stock-lot-dashlet"/>

  <!-- totaux en bas de la liste, comme GESCOM : tous les lots filtrés (pas seulement la page affichée), recalculés à
       chaque recherche (LvmeImpressionListesController.totauxEtatStock) -->
  <panel name="totauxPanel" showTitle="false" colSpan="12" css="lvme-ges-etat lvme-ges-totaux">
    <label name="totauxTitre" title="Totaux" colSpan="4" css="lvme-ges-totaux-titre"/>
    <field name="$totColisIn" title="Nb Colis Entrées" type="decimal" x-scale="3" readonly="true" colSpan="1"/>
    <field name="$totColisOut" title="Nb Colis Sorties" type="decimal" x-scale="3" readonly="true" colSpan="1"/>
    <field name="$totColisCdes" title="Nb colis Cdes" type="decimal" x-scale="3" readonly="true" colSpan="1"/>
    <field name="$totColisStock" title="Nb colis Stock" type="decimal" x-scale="3" readonly="true" colSpan="1"/>
    <field name="$totQtyStock" title="Unt/Poids Stock" type="decimal" x-scale="3" readonly="true" colSpan="1"/>
    <field name="$totValeurStock" title="Montant ht Stock" type="decimal" x-scale="2" readonly="true" colSpan="1"/>
    <field name="$totColisDispo" title="Nb colis Dispo" type="decimal" x-scale="3" readonly="true" colSpan="1"/>
    <field name="$totQtyDispo" title="Unt/Poids Dispo" type="decimal" x-scale="3" readonly="true" colSpan="1"/>
  </panel>

  <!-- boutons d'impression en bas, comme GESCOM : « Etat des Stocks sur une ligne », « Etat des Stocks / Fournisseur »,
       « Etat des Stocks » (mêmes filtres que la liste) -->
  <panel name="impressionsPanel" showTitle="false" colSpan="12" css="lvme-ges-etat">
    <button colSpan="3" name="imprimerEtatLigneBtn" title="Etat des Stocks sur une ligne" icon="printer"
      onClick="action-lvme-etat-stock-lot-imprimer-ligne"/>
    <button name="imprimerEtatLigneBtnExcel" title="Excel" icon="file-earmark-excel" css="btn-success" colSpan="1" onClick="action-lvme-etat-stock-lot-imprimer-ligne-excel"/>
    <button colSpan="3" name="imprimerEtatFournisseurBtn" title="Etat des Stocks / Fournisseur" icon="printer"
      onClick="action-lvme-etat-stock-lot-imprimer-fournisseur"/>
    <button name="imprimerEtatFournisseurBtnExcel" title="Excel" icon="file-earmark-excel" css="btn-success" colSpan="1" onClick="action-lvme-etat-stock-lot-imprimer-fournisseur-excel"/>
    <button colSpan="3" name="imprimerEtatBtn" title="Etat des Stocks" icon="printer"
      onClick="action-lvme-etat-stock-lot-imprimer"/>
    <button name="imprimerEtatBtnExcel" title="Excel" icon="file-earmark-excel" css="btn-success" colSpan="1" onClick="action-lvme-etat-stock-lot-imprimer-excel"/>
  </panel>

</form>


