<grid name="lvme-cdes-client-lignes-grid" title="Commandes Clients" model="com.axelor.apps.sale.db.SaleOrderLine"
  orderBy="saleOrder.orderDate,saleOrder.saleOrderSeq,sequence" canNew="false" canEdit="false" canDelete="false">
  <!-- LVME : colonnes de l'écran « Commandes Clients » GESCOM (une ligne par ligne de commande client) -->
  <hilite color="danger" if="subMarginRate &lt; 0"/>
  <field name="saleOrder.saleOrderSeq" title="N°" width="100"/>
  <field name="saleOrder.statusSelect" title="Statut" selection="sale.order.status.select" width="110"/>
  <field name="saleOrder.orderDate" title="Date Commande" width="100"/>
  <field name="saleOrder.estimatedDeliveryDate" title="Date Livraison" width="100"/>
  <field name="saleOrder.clientPartner.partnerSeq" title="Client" width="90"/>
  <field name="saleOrder.clientPartner.name" title="Nom" width="220"/>
  <field name="saleOrder.commercial.name" title="Commercial" width="150"/>
  <field name="product.code" title="Produit" width="110"/>
  <field name="lvmeArrivages" title="N° Arrivage" width="100"/>
  <field name="lvmeLots" title="N° Lot" width="120"/>
  <field name="prixRevient" title="P.Rev Arrivage" width="90"/>
  <field name="price" title="Prix Vente" width="85"/>
  <field name="prixRevientNet" title="P.Rev.Net" width="85"/>
  <field name="priceDiscounted" title="P.V. Net" width="85"/>
  <field name="subMarginRate" title="% Marge" width="75"/>
  <field name="nbColis" title="Nb Colis" aggregate="sum" width="80"/>
  <field name="poidsParColis" title="Pds/unités d'un Colis" width="90"/>
  <field name="qty" title="Poids en kg" aggregate="sum" width="95"/>
</grid>
