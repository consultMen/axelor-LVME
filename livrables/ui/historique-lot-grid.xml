<grid name="lvme-historique-lot-grid" title="Liste des Mouvements de Stock" model="com.axelor.apps.stock.db.StockMoveLine"
  orderBy="stockMove.realDate,stockMove.estimatedDate,id" canNew="false" canEdit="false" canDelete="false" css="lvme-gescom-liste">
  <!-- LVME : « Liste des Mouvements de Stock » GESCOM d'un lot (bouton Historique Lot de la ligne de commande),
       mêmes colonnes et totaux en bas -->
  <field name="stockMove.realDate" title="Date" width="90"/>
  <field name="stockMove.stockMoveSeq" title="Libellé Mvts" width="200"/>
  <field name="stockMove.typeSelect" title="Type" width="80"/>
  <field name="stockMove.partner.partnerSeq" title="Réf.Tiers" width="90"/>
  <field name="unitPriceUntaxed" title="Prix Vente" x-scale="4" width="85"/>
  <field name="prKg" title="Prix Revient" x-scale="4" width="85"/>
  <field name="lvmeColisEntres" title="Colis Entrés" aggregate="sum" x-scale="0" width="85"/>
  <field name="lvmeColisSortis" title="Colis Sortis" aggregate="sum" x-scale="0" width="85"/>
  <field name="lvmeQteEntrees" title="Qtes Entrées" aggregate="sum" x-scale="3" width="95"/>
  <field name="lvmeQteSorties" title="Qtes Sorties" aggregate="sum" x-scale="3" width="95"/>
</grid>
