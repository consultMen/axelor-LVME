<form name="lvme-commande-client-search-form" title="Listes Commandes Clients" model="com.axelor.utils.db.Wizard" width="large"
  canNew="false" canSave="false" canCopy="false" canDelete="false" onNew="action-lvme-cde-client-defaults,action-lvme-cde-client-kpi">
  <!-- LVME : écran « Listes Commandes Clients » de GESCOM : filtres + liste des commandes clients -->
  <!-- LVME : 4 KPI des commandes clients (calculés à l'ouverture, action-lvme-cde-client-kpi) -->
  <panel name="kpiCdeClientPanel" showTitle="false" colSpan="12">
    <field name="$kpiEnCours" type="string" hidden="true"/>
    <field name="$kpiEnCoursDetail" type="string" hidden="true"/>
    <field name="$kpiCaMois" type="string" hidden="true"/>
    <field name="$kpiCaMoisDetail" type="string" hidden="true"/>
    <field name="$kpiMarge" type="string" hidden="true"/>
    <field name="$kpiMargeDetail" type="string" hidden="true"/>
    <field name="$kpiALivrer" type="string" hidden="true"/>
    <field name="$kpiRetard" type="string" hidden="true"/>
    <field name="$kpiCdeTuiles" showTitle="false" readonly="true" colSpan="12" type="string">
      <viewer depends="$kpiEnCours,$kpiEnCoursDetail,$kpiCaMois,$kpiCaMoisDetail,$kpiMarge,$kpiMargeDetail,$kpiALivrer,$kpiRetard"><![CDATA[
        <>
          <Box d="grid" style={{ gridTemplateColumns: 'repeat(4, 1fr)', gap: 12 }}>
            <Box style={{ border: '1px solid #0d6efd', borderLeft: '6px solid #0d6efd', borderRadius: 8, padding: 12 }}>
              <Box style={{ fontSize: 13, color: '#666' }}>Commandes en cours</Box>
              <Box style={{ fontSize: 26, fontWeight: 'bold' }}>{$kpiEnCours}</Box>
              <Box style={{ fontSize: 12, color: '#666' }}>{$kpiEnCoursDetail}</Box>
            </Box>
            <Box style={{ border: '1px solid #198754', borderLeft: '6px solid #198754', borderRadius: 8, padding: 12 }}>
              <Box style={{ fontSize: 13, color: '#666' }}>CA HT du mois</Box>
              <Box style={{ fontSize: 26, fontWeight: 'bold' }}>{$kpiCaMois}</Box>
              <Box style={{ fontSize: 12, color: '#666' }}>{$kpiCaMoisDetail}</Box>
            </Box>
            <Box style={{ border: '1px solid #6f42c1', borderLeft: '6px solid #6f42c1', borderRadius: 8, padding: 12 }}>
              <Box style={{ fontSize: 13, color: '#666' }}>% Marge du mois</Box>
              <Box style={{ fontSize: 26, fontWeight: 'bold' }}>{$kpiMarge}</Box>
              <Box style={{ fontSize: 12, color: '#666' }}>{$kpiMargeDetail}</Box>
            </Box>
            <Box style={{ border: '1px solid #fd7e14', borderLeft: '6px solid #fd7e14', borderRadius: 8, padding: 12 }}>
              <Box style={{ fontSize: 13, color: '#666' }}>À livrer aujourd'hui</Box>
              <Box style={{ fontSize: 26, fontWeight: 'bold' }}>{$kpiALivrer}</Box>
              <Box style={{ fontSize: 12, color: '#dc3545' }}>{$kpiRetard}</Box>
            </Box>
          </Box>
        </>
      ]]></viewer>
    </field>
  </panel>
  <panel name="rechercheCdePanel" title="Recherche" colSpan="12">
    <panel name="filtreEtatPanel" colSpan="3" itemSpan="12">
      <field name="$etatCommande" showTitle="false" type="integer" widget="RadioSelect" selection="lvme.commande.client.etat.select"/>
    </panel>
    <panel name="filtreClientPanel" colSpan="3" itemSpan="12">
      <field name="$client" title="Client" type="many-to-one" target="com.axelor.apps.base.db.Partner"
        domain="self.isCustomer = true" canNew="false" canEdit="false" canView="false"/>
      <field name="$commercialFiltre" title="Commercial" type="many-to-one" target="com.axelor.auth.db.User"
        canNew="false" canEdit="false" canView="false"/>
      <button name="nouvelleCdeBtn" title="Nouvelle Cde" icon="plus" onClick="action-lvme-cde-client-new"/>
    </panel>
    <panel name="filtreDatePanel" colSpan="3" itemSpan="12">
      <field name="$dateDu" title="Date du" type="date"/>
      <field name="$dateAu" title="au" type="date"/>
      <field name="$datePeriode" title="Période prédéfinie" type="integer" selection="lvme.etat.stock.periode.select"
        onChange="action-lvme-cde-client-periode-date"/>
    </panel>
    <panel name="filtreLivraisonPanel" colSpan="3" itemSpan="12">
      <field name="$livraisonDu" title="Livraison du" type="date"/>
      <field name="$livraisonAu" title="au" type="date"/>
      <field name="$livraisonPeriode" title="Période prédéfinie" type="integer" selection="lvme.etat.stock.periode.select"
        onChange="action-lvme-cde-client-periode-livraison"/>
      <button name="lancerRechercheBtn" title="Lancer la recherche" icon="search" css="btn-primary" onClick="action-lvme-cde-client-refresh"/>
    </panel>
  </panel>
  <panel-dashlet name="commandesDashlet" title="Commandes clients" colSpan="12" height="600" action="action-lvme-cde-client-dashlet"/>
</form>
