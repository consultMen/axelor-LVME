<form name="lvme-synthese-arrivage-form" title="Synthèse des Arrivages" model="com.axelor.utils.db.Wizard" width="large"
  canNew="false" canSave="false" canCopy="false" canDelete="false" onNew="action-lvme-synthese-arrivage-defaults">
  <!-- LVME : écran « Synthèse des Arrivages » de GESCOM (diapo 24), sur un seul écran (cadre N° css="lvme-ges-synth") :
       N° d'arrivage du / au, cadre Arrivée jaune, Lancer la recherche, Fermer à droite, bouton Synthèse en bas -->
  <panel name="filtresSynthesePanel" showTitle="false" colSpan="12">
    <panel name="filtreNumeroPanel" colSpan="2" itemSpan="12" css="lvme-ges-synth">
      <field name="$arrivageDu" title="Arrivage N° du" type="string"/>
      <field name="$arrivageAu" title="au" type="string"/>
    </panel>
    <panel name="filtreArriveePanel" colSpan="3" itemSpan="12" css="lvme-ges-dates-jaune-rot">
      <field name="$arriveeDu" title="Arrivée du" type="date"/>
      <field name="$arriveeAu" title="au" type="date"/>
      <field name="$arriveePeriode" title="Période prédéfinie" type="integer" selection="lvme.etat.stock.periode.select"
        onChange="action-lvme-synthese-arrivage-periode"/>
    </panel>
    <panel name="filtreBoutonPanel" colSpan="2" itemSpan="12">
      <button name="lancerRechercheBtn" title="Lancer la recherche" icon="search" onClick="action-lvme-synthese-arrivage-refresh"/>
    </panel>
    <panel name="filtreFermerPanel" colSpan="5">
      <spacer colSpan="8"/>
      <button name="fermerBtn" title="Fermer" icon="x-circle" colSpan="4" onClick="close"/>
    </panel>
  </panel>
  <panel-dashlet name="syntheseDashlet" title="Synthèse des Arrivages" showTitle="false" colSpan="12" height="620"
    action="action-lvme-synthese-arrivage-dashlet"/>
  <panel name="syntheseBasPanel" showTitle="false" colSpan="12">
    <!-- bouton « Synthèse » en bas à droite comme GESCOM : impression LVME de la synthèse (PROD_91) -->
    <spacer colSpan="8"/>
    <button colSpan="2" name="syntheseBtn" title="Synthèse" icon="printer" onClick="action-lvme-synthese-arrivage-imprimer"/>
    <button name="syntheseBtnExcel" title="Excel" icon="file-earmark-excel" css="btn-success" colSpan="2" onClick="action-lvme-synthese-arrivage-imprimer-excel"/>
  </panel>
</form>
