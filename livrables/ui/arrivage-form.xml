<form name="lvme-arrivage-form" title="Arrivage" model="com.axelor.apps.stock.db.StockMove" width="large"
  onLoad="action-group-stock-stockmove-onload, action-stock-move-attrs-fill-ctx, action-lvme-arrivage-attrs-devise, action-lvme-arrivage-attrs-etape, action-lvme-arrivage-attrs-somme"
  onSave="action-stock-move-group-save-and-update-stocks"
  onNew="action-group-stock-stockmove-onnew, action-stock-move-attrs-fill-ctx, action-lvme-arrivage-attrs-etape">
  <!-- LVME : fiche « Arrivages » de GESCOM = réception fournisseur Axelor (mêmes actions que la fiche standard) -->
  <menubar>
    <menu name="stockMoveReportsMenu" title="Editer" icon="fa-files-o">
      <item name="printIncomingMoveItem" title="Imprimer l'arrivage" readonlyIf="statusSelect == 1" action="save,action-lvme-arrivage-imprimer"/>
      <item name="printCertificateOfConformityItem" title="Print certificate of conformity" showIf="statusSelect != 1 &amp;&amp; isNeedingConformityCertificate" action="action-stock-move-group-save-and-update-stocks,action-method-print-conformity-certificate"/>
    </menu>
    <menu name="stockMoveToolsMenu" title="Tools" icon="fa-wrench">
      <item name="splitIntoItem" title="Split into 2" showIf="statusSelect &lt;= 2" action="action-stock-move-group-save-and-update-stocks,action-stock-move-split-into-2"/>
      <item name="splitByUnitItem" title="Split by unit" showIf="statusSelect &lt;= 2" action="action-stock-move-group-save-and-update-stocks,action-stock-move-method-split-stock-move-lines-unit"/>
      <item name="specialSplitItem" title="Special split" showIf="statusSelect &lt;= 2" action="action-stock-move-group-save-and-update-stocks,action-stock-move-wizard-special-split"/>
      <item name="shipReceiveAllProductsItem" title="Ship/Receive all products" action="action-stock-move-group-save-and-update-stocks,action-stock-move-ship-recieve-all-products"/>
      <item name="fillRealQties" title="Fill real quantities" action="action-supplychain-stock-move-method-fill-real-quantities"/>
    </menu>
  </menubar>

  <!-- LVME : copie de l'écran « Arrivages » GESCOM (même ordre, mêmes blocs) : tout l'arrivage et ses
       lignes visibles sans défiler. Fournisseur | Arrivage | Devise + tableau Flottant / Réel | Actions -->
  <!-- barre des étapes de l'arrivage, même présentation que la commande fournisseur :
       Brouillon > A embarquer > Flottant > Réel > Annulé (d'après la nature, remplie à l'ouverture) -->
  <panel name="lvmeStatutPanel" colSpan="12">
    <field name="$etapeArrivage" type="integer" showTitle="false" readonly="true" colSpan="12" widget="NavSelect"
      selection="lvme.arrivage.etape.select"/>
  </panel>
  <panel name="mainPanel" colSpan="12" css="lvme-gescom">
    <panel name="lvmeFournisseurPanel" colSpan="4" itemSpan="6" css="lvme-gescom lvme-gescom-box">
      <field name="partner" title="Fournisseur" colSpan="8" readonlyIf="statusSelect != 1" canEdit="false" onChange="action-stock-move-group-partner-onchange" domain="self.isContact = false AND :company member of self.companySet" form-view="partner-form" grid-view="partner-grid" x-image-field="picture"/>
      <field name="partner.partnerSeq" title="Code" readonly="true" colSpan="4"/>
      <!-- adresse complète du fournisseur sur une ligne (remplie au choix du fournisseur) -->
      <field name="fromAddressStr" title="Adresse" readonly="true" colSpan="12">
        <viewer depends="fromAddressStr"><![CDATA[<>{(fromAddressStr || "").split(/\r?\n/).map(l => l.trim()).filter(l => l).join(", ")}</>]]></viewer>
      </field>
      <field name="lvmeContact" title="Contact" readonly="true" colSpan="12"/>
      <field name="partner.fixedPhone" title="Tél." readonly="true" colSpan="6"/>
      <field name="partner.emailAddress" colSpan="6" title="Email" readonly="true"/>
      <field name="lvmeReglement" colSpan="6" title="Règlement" readonly="true"/>
      <field name="lvmeEcheance" colSpan="6" title="Echéance" readonly="true"/>
    </panel>

    <panel name="lvmeArrivagePanel" colSpan="3" itemSpan="6" css="lvme-gescom">
      <field name="createdBy" colSpan="6" title="Opérateur" readonly="true" canView="false"/>
      <field name="toStockLocation" colSpan="6" title="Frigo" canEdit="false" onChange="action-stock-move-group-to-location-onchange" domain="self.company = :company AND self.typeSelect != 3 AND (self.usableOnPurchaseOrder = true AND :isReversion = false OR self.usableOnSaleOrder = true AND :isReversion = true)" form-view="stock-location-form" grid-view="stock-location-grid"/>
      <field name="stockMoveSeq" colSpan="6" title="Arrivage N°" readonly="true"/>
      <field name="createdOn" colSpan="6" title="Du" readonly="true"/>
      <field name="lvmeAEmbarquer" title="A Embarquer" readonly="true" colSpan="6"/>
      <field name="nature" showTitle="false" readonly="true" colSpan="6">
        <viewer depends="nature"><![CDATA[
          <>
            {(nature == 'EN_COURS_DE_PRODUCTION' || nature == 'FLOTTANT') && <Box as="span" style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", padding: "2px 14px", fontSize: 16, display: "inline-block" }}>Flottant</Box>}
            {nature == 'REEL' && <Box as="span" style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", padding: "2px 14px", fontSize: 16, display: "inline-block" }}>Réel</Box>}
            {nature == 'DRAFT' && <Box as="span" style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", padding: "2px 14px", fontSize: 16, display: "inline-block" }}>Brouillon</Box>}
            {nature == 'ANNULE' && <Box as="span" style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", padding: "2px 14px", fontSize: 16, display: "inline-block" }}>Annulé</Box>}
          </>
        ]]></viewer>
      </field>
      <field name="supplierShipmentDate" colSpan="6" title="Date Départ" showIf="!isReversion"/>
      <panel name="lvmeArriveePanel" colSpan="6" itemSpan="12" showTitle="false">
        <field name="estimatedDate" showIf="statusSelect != 3" colSpan="12" title="Arrivée" readonlyIf="(statusSelect != 1 &amp;&amp; statusSelect != 2) || pickingIsEdited"/>
        <field name="realDate" title="Arrivée" readonly="true" colSpan="12" showIf="statusSelect == 3"/>
      </panel>
      <field name="shipmentMode" colSpan="6" title="Type transport" canEdit="false" form-view="shipment-mode-form" grid-view="shipment-mode-grid"/>
      <field name="bateau" colSpan="6" title="Bateau" canNew="true" form-view="lvme-bateau-form" grid-view="lvme-bateau-grid"/>
      <field name="containerSet" colSpan="6" title="Containers" widget="TagSelect" canNew="true" form-view="lvme-container-form" grid-view="lvme-container-grid"/>
      <field name="forwarderPartner" colSpan="6" title="Transitaire" canEdit="false" domain="self.isContact = FALSE AND (self.isCarrier = TRUE OR self.isSupplier = TRUE) AND :company MEMBER OF self.companySet" form-view="partner-form" grid-view="partner-grid"/>
    </panel>

    <panel name="lvmeDevisePanel" colSpan="3" itemSpan="6" css="lvme-gescom">
      <field name="$deviseAchat" title="Devise" type="string" readonly="true" colSpan="12"/>
      <!-- LVME : taux de change GESCOM, archivage seulement (aucun calcul) -->
      <field name="lvmeCours" title="Cours" colSpan="6"/>
      <field name="lvmeCouvert" title="Couvert" colSpan="6"/>
      <field name="lvmeFlottant" title="Flottant" colSpan="6"/>
      <field name="lvmeReel" title="Réel" colSpan="6"/>
      <!-- tableau Flottant / Réel de GESCOM : ligne Flottant tant que l'arrivage n'est pas réalisé, Réel ensuite -->
      <field name="exTaxTotal" showTitle="false" readonly="true" colSpan="12">
        <viewer depends="exTaxTotal,nbColisTotal,poidsTotal,lvmeFraisApproche,statusSelect"><![CDATA[
          <>
            <table style={{ width: "100%", borderCollapse: "separate", borderSpacing: 3, fontSize: 13 }}>
              <thead>
                <tr style={{ color: "#8b1a8b" }}>
                  <th></th><th style={{ textAlign: "center" }}>Mt Achat HT</th><th style={{ textAlign: "center" }}>Nb Colis</th><th style={{ textAlign: "center" }}>Poids Total</th><th style={{ textAlign: "center" }}>Frais Appr</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style={{ color: "#c000c0", whiteSpace: "nowrap" }}>Flottant =&gt;</td>
                  <td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px" }}>{$fmt("exTaxTotal")}</td>
                  <td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px" }}>{$fmt("nbColisTotal")}</td>
                  <td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px" }}>{$fmt("poidsTotal")}</td>
                  <td></td>
                </tr>
                <tr>
                  <td style={{ color: "#c000c0", whiteSpace: "nowrap" }}>Réel =&gt;</td>
                  <td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px" }}>{statusSelect == 3 ? $fmt("exTaxTotal") : 0}</td>
                  <td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px" }}>{statusSelect == 3 ? $fmt("nbColisTotal") : 0}</td>
                  <td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px" }}>{statusSelect == 3 ? $fmt("poidsTotal") : 0}</td>
                  <td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px" }}>{statusSelect == 3 ? (+lvmeFraisApproche || 0).toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 4 }) : 0}</td>
                </tr>
              </tbody>
            </table>
          </>
        ]]></viewer>
      </field>
      <field name="lvmeMontantSociete" title="Équivalent" readonly="true" colSpan="12" showIf="$deviseAchat != $deviseComptable">
        <viewer depends="lvmeMontantSociete,$deviseComptable"><![CDATA[
          <>
            <Box as="span" fontWeight="bold">{$fmt('lvmeMontantSociete')} {$deviseComptable}</Box>
          </>
        ]]></viewer>
      </field>
    </panel>

    <panel name="actionPanel" colSpan="2" itemSpan="12">
      <!-- LVME : bouton « Editer » de GESCOM (impression de l'arrivage), visible aussi quand la fiche s'ouvre en fenêtre -->
      <button name="lvmeEditerBtn" title="Editer" icon="printer" showIf="id &amp;&amp; statusSelect != 1" onClick="save,action-lvme-arrivage-imprimer"/>
      <button name="planBtn" title="Plan" showIf="statusSelect == 1" icon="fa-calendar" onClick="action-group-stock-stockmove-plan-click"/>
      <button name="lvmeFlottantBtn" title="A Embarquer -> flottant" showIf="statusSelect == 2 &amp;&amp; nature != 'FLOTTANT'" css="btn-info" onClick="action-lvme-arrivage-record-flottant,save,action-lvme-arrivage-attrs-etape"/>
      <!-- LVME : retour en arrière de GESCOM, flottant -> à embarquer (lots FL -> AE) -->
      <button name="lvmeAEmbarquerBtn" title="Flottant -> A Embarquer" showIf="statusSelect == 2 &amp;&amp; nature == 'FLOTTANT'" css="btn-info" prompt="Repasser l'arrivage en « A embarquer » ?" onClick="action-lvme-arrivage-record-a-embarquer,save,action-lvme-arrivage-attrs-etape"/>
      <button name="realizeBtn" title="Saisie Réel" showIf="statusSelect == 2" css="btn-success" icon="fa-check" prompt="Are you sure you want to realize this stock move?" onClick="action-group-stock-stockmove-realize-click"/>
      <button if="__config__.app.isApp('supplychain') &amp;&amp; __config__.app.getApp('account')?.getActivatePassedForPayment()" if-module="axelor-supplychain" name="passedForPaymentAuthorizedBtn" title="PFP authorized" showIf="pfpValidateStatusSelect != 2" onClick="action-stock-move-group-save-and-update-stocks,action-stock-move-record-pfp-validate,save"/>
      <button if="__config__.app.isApp('supplychain') &amp;&amp; __config__.app.getApp('account')?.getActivatePassedForPayment()" if-module="axelor-supplychain" name="refusalToPayLitigationBtn" title="PFP litigation" showIf="pfpValidateStatusSelect != 3" onClick="action-stock-move-group-save-and-update-stocks,action-stock-move-record-pfp-refusal-to-pay,save"/>
      <button if="__config__.app.isApp('supplychain') &amp;&amp; __config__.app.getApp('supplychain')?.getGenerateInvoiceFromStockMove()" if-module="axelor-supplychain" name="generateInvoiceBtn" title="Factures" hidden="true" icon="fa-file-o" onClick="save,action-supplychain-stock-move-validate-invoicing-block,action-supplychain-stock-move-method-invoicing-wizard"/>
      <button name="generateReversionBtn" title="Generate reversion" showIf="statusSelect == 3 &amp;&amp; !isReversion" icon="fa-undo" onClick="save,action-stock-move-method-generate-reversion"/>
      <button name="cancelBtn" title="Cancel" showIf="id != null &amp;&amp; statusSelect > 1 &amp;&amp; statusSelect &lt; 4" css="btn-danger" icon="fa-times-circle" onClick="action-group-stock-stockmove-cancel-click"/>
      <button name="draftBtn" title="Draft" showIf="statusSelect == 4" onClick="action-stock-move-method-draft"/>
      <button name="lvmeAppliquerFrigoBtn" title="Frigo → toutes les lignes" icon="arrow-down-square" showIf="id &amp;&amp; statusSelect != 3" prompt="Mettre le frigo de l'arrivage sur toutes les lignes ?" onClick="save,action-lvme-arrivage-appliquer-frigo"/>
    </panel>

    <!-- champs techniques et paramètres (cachés), gardés pour le fonctionnement de la fiche -->
    <panel name="lvmeTechPanel" hidden="true" colSpan="12">
      <field name="statusSelect"/>
      <field name="$deviseComptable" type="string"/>
      <field name="$currencySymbol" type="string"/>
      <field name="fromAddress" title="Adresse" colSpan="8" readonlyIf="statusSelect == 3 || statusSelect == 4" onChange="action-stock-move-method-set-addresses-str" onSelect="action-stock-move-attrs-domain-address" form-view="address-form"/>
      <field name="nbColisTotal"/>
      <field name="poidsTotal"/>
      <field name="lvmeFraisApproche"/>
      <field name="company" readonlyIf="statusSelect != 1" canEdit="false" onChange="action-stock-move-group-onchange-company" form-view="company-form" grid-view="company-grid"/>
      <field if="__config__.app.getApp('base')?.enableTradingNamesManagement" name="tradingName" readonlyIf="statusSelect >= 2" canEdit="false" onChange="action-stock-move-method-printing-settings-default-value,action-stock-move-record-set-trading-name-stock-locations-default" domain="self.company = :company" form-view="trading-name-form" grid-view="trading-name-grid"/>
      <field name="fromStockLocation" title="Emplacement départ" canEdit="false" form-view="stock-location-form" grid-view="stock-location-grid"/>
      <field name="freightCarrierMode" title="Mode transporteur" canEdit="false" onChange="action-stock-move-record-freight-carrier" domain="self.shipmentMode = :shipmentMode" form-view="freight-carrier-mode-form" grid-view="freight-carrier-mode-grid"/>
      <field name="incoterm" canEdit="false" form-view="incoterm-form" grid-view="incoterm-grid"/>
      <field name="isWithBackorder"/>
      <field name="conformitySelect" showIf="statusSelect == 2" onChange="action-stock-move-method-change-conformity"/>
      <field name="typeSelect" readonly="true"/>
      <field name="isReversion" hidden="true"/>
      <field name="pickingIsEdited" hidden="true"/>
      <field name="invoicingStatusSelect" hidden="true"/>
      <field name="isNeedingConformityCertificate" hidden="true"/>
      <field name="toStockLocation.typeSelect" hidden="true"/>
      <field if="__config__.app.isApp('supplychain')" if-module="axelor-supplychain" name="pfpValidateStatusSelect" hidden="true"/>
    </panel>
  </panel>

  <panel-related name="stockMoveLineListPanel" title="Lignes d'arrivage" css="lvme-gescom-grid" readonlyIf="company == null || fromStockLocation == null || toStockLocation == null || statusSelect == 3" height="14" field="stockMoveLineList" form-view="lvme-arrivage-line-form" grid-view="lvme-arrivage-line-grid" orderBy="sequence" onNew="action-stock-move-line-record-filter-on-available-products, action-stock-move-line-record-fill-stock-location" onChange="action-stock-move-line-change-group,action-lvme-arrivage-attrs-somme" canNew="true" canRemove="!(statusSelect == 2 &amp;&amp; pickingIsEdited)" canMove="true"/>
  <!-- LVME : totaux de GESCOM sous les lignes d'arrivage (nb unités ou poids : réel une fois réalisé) -->
  <panel name="lvmeSommePanel" showTitle="false" colSpan="12" css="lvme-somme">
    <field name="$lvmeSommeLignes" type="string" showTitle="false" readonly="true" colSpan="12">
      <viewer depends="$sommeColis,$sommeQte,$sommePoids,$sommeMontant"><![CDATA[
        <><table style={{ borderCollapse: "separate", borderSpacing: 3, fontSize: 13, marginLeft: "auto" }}><thead><tr><th style={{ fontWeight: 400, fontStyle: "italic", color: "#1a1ad6", padding: "0 8px", textAlign: "center" }}>Nb Colis</th><th style={{ fontWeight: 400, fontStyle: "italic", color: "#1a1ad6", padding: "0 8px", textAlign: "center" }}>Nb unités ou poids</th><th style={{ fontWeight: 400, fontStyle: "italic", color: "#1a1ad6", padding: "0 8px", textAlign: "center" }}>Poids Kg</th><th style={{ fontWeight: 400, fontStyle: "italic", color: "#1a1ad6", padding: "0 8px", textAlign: "center" }}>Montant ht</th></tr></thead><tbody><tr><td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 8px", minWidth: 90 }}>{(v => (+v || 0).toLocaleString("fr-FR", { minimumFractionDigits: 3, maximumFractionDigits: 3 }))($sommeColis)}</td><td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 8px", minWidth: 90 }}>{(v => (+v || 0).toLocaleString("fr-FR", { minimumFractionDigits: 3, maximumFractionDigits: 3 }))($sommeQte)}</td><td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 8px", minWidth: 90 }}>{(v => (+v || 0).toLocaleString("fr-FR", { minimumFractionDigits: 3, maximumFractionDigits: 3 }))($sommePoids)}</td><td style={{ background: "#ffff99", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 8px", minWidth: 90 }}>{(v => (+v || 0).toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }))($sommeMontant)}</td></tr></tbody></table></>
      ]]></viewer>
    </field>
    <field name="$sommeColis" type="decimal" hidden="true"/>
    <field name="$sommeQte" type="decimal" hidden="true"/>
    <field name="$sommePoids" type="decimal" hidden="true"/>
    <field name="$sommeMontant" type="decimal" hidden="true"/>
  </panel>

  <panel name="lvmeNotePanel" title="Obs" colSpan="12" canCollapse="true" collapseIf="!note">
    <field name="note" showTitle="false" colSpan="12" widget="html" x-lite="true"/>
  </panel>

  <panel-mail name="mailPanel">
    <mail-messages limit="4"/>
    <mail-followers/>
  </panel-mail>
</form>
