<form name="lvme-arrivage-line-form" title="Ligne d'arrivage" model="com.axelor.apps.stock.db.StockMoveLine" width="large" onLoad="action-stock-move-line-group-onload" onNew="action-stock-move-line-group-onnew" readonlyIf="$isReadOnly" canNew="false" canDelete="false">
  <panel name="productPanel" showIf="lineTypeSelect == 1">
    <field name="productName" colSpan="9"/>
    <field name="lineTypeSelect" colSpan="3" onChange="action-stock-move-line-method-empty-line"/>
    <field name="qty" hidden="true" hideIf="lineTypeSelect == 1" x-scale="$nbDecimalDigitForQty"/>
    <field name="realQty" hidden="true" hideIf="lineTypeSelect == 1" x-scale="$nbDecimalDigitForQty"/>
  </panel>
  <!-- LVME : copie de la fenêtre « Lignes Arrivages » GESCOM (mêmes champs et actions que la fiche
       ligne standard, disposés comme GESCOM, sans défiler). Utilisée par la fiche Arrivage. -->
  <panel name="mainPanel" hideIf="lineTypeSelect == 1" colSpan="12">
    <panel name="lvmeLigneGescomPanel" colSpan="10" css="lvme-gescom">
      <field title="Article" name="product" readonlyIf="($get('stockMove.statusSelect') == 2 &amp;&amp; $get('stockMove.pickingIsEdited')) || $get('stockMove.statusSelect') > 2" canEdit="false" onChange="action-stock-move-line-tracking-number-attrs,action-group-stock-stockmoveline-product-onchange" onSelect="action-stock-move-line-method-product-domain" domain="self.expense = false AND self.dtype = 'Product'" form-view="product-form" grid-view="stock-move-line-product-grid" x-image-field="picture" colSpan="3"/>
      <field title="Désignation" name="productName" colSpan="5"/>
      <field name="product.nomScientifique" title="Nom scientifique" readonly="true" colSpan="2"/>
      <field name="product.customsCodeNomenclature" title="Réf. douanière" readonly="true" colSpan="2"/>
      <field title="N° Lot" name="trackingNumber" readonlyIf="$get('stockMove.statusSelect') > 2" canNew="product != null" onChange="action-stock-move-line-record-product" onSelect="action-stock-move-line-attrs-tracking-number-domain" form-view="tracking-number-stock-move-line-form" grid-view="tracking-number-grid" colSpan="3"/>
      <field name="dateCongelation" title="Date Congélation" colSpan="2" readonly="true"/>
      <field name="purchaseOrderLine.conditionnement" title="Condit." colSpan="3" readonly="true" showIf="purchaseOrderLine != null"/>
      <field title="Coef." name="coefPoidsNet" colSpan="1" readonly="true" x-scale="3"/>
      <field title="Unité Vente" name="unit" colSpan="3" canEdit="false" form-view="unit-form" grid-view="unit-grid"/>
      <field name="lotFournisseur" title="N° Lot Fourn." colSpan="3" canNew="true" canEdit="true" form-view="lot-fournisseur-form" grid-view="lot-fournisseur-grid" onChange="action-stock-move-line-record-lot-fournisseur-onchange,action-stock-move-line-record-compute-dluo" onSelect="action-stock-move-line-attrs-lot-fournisseur-domain"/>
      <field name="durabilite" title="Durabilité" colSpan="2" readonly="true"/>
      <field name="dluo" title="D.L.U.O." colSpan="2" readonly="true"/>
      <field name="origine" title="Origine" colSpan="2" readonly="true"/>
      <field name="marque" title="Marque" colSpan="3" readonly="true"/>
      <field title="Frigo" colSpan="3" name="toStockLocation" onChange="action-stock-move-line-group-stock-location-onchange" onSelect="action-stock-move-line-method-compute-to-stock-location-domain"/>
      <field name="purchaseOrderLine.taxLineSet" title="Taux TVA" readonly="true" colSpan="2" widget="TagSelect"/>
      <field name="zonePeche" title="Zone Pêche" colSpan="2" readonly="true"/>
      <field name="modePeche" title="Mode Pêche" colSpan="2" readonly="true"/>
      <field name="fraisApprocheKg" title="Frais d'approche au kg" colSpan="3" readonly="true" x-scale="$nbDecimalDigitForUnitPrice"/>
      <field name="product.gencode" title="Gencode" readonly="true" colSpan="3"/>
      <field name="product.refFournisseur" title="Réf. Fourn." readonly="true" colSpan="2"/>
      <field name="purchaseOrderLine.nbColisParCouche" title="Nb Colis / Couche" readonly="true" colSpan="2"/>
      <field name="purchaseOrderLine.nbColisParPalette" title="Nb Colis / Palette" readonly="true" colSpan="2"/>
      <field title="Qté prévue" colSpan="1" name="qty" hidden="true" hideIf="lineTypeSelect == 1" x-scale="$nbDecimalDigitForQty"/>
      <field title="Qté réelle" colSpan="2" name="realQty" hidden="true" hideIf="lineTypeSelect == 1" x-scale="$nbDecimalDigitForQty"/>
      <!-- tableau GESCOM : Flottant tant que l'arrivage n'est pas réalisé, Réel ensuite -->
      <field name="montantReel" showTitle="false" readonly="true" colSpan="12">
        <viewer depends="nbColis,nbUnitesParColis,unitesTot,poidsParColis,poidsTotalNet,unitPriceUntaxed,paDevise,prKg,montantReel,stockMove.statusSelect"><![CDATA[
          <>
            <table style={{ borderCollapse: "separate", borderSpacing: 4, fontSize: 13 }}>
              <thead><tr>
                <th></th><th style={{ color: "#1a1ad6", fontStyle: "italic", textAlign: "center", fontWeight: 400 }}>Nb Colis</th><th style={{ color: "#1a1ad6", fontStyle: "italic", textAlign: "center", fontWeight: 400 }}>Nb Unité ou<br/>Poids d'un Colis</th><th style={{ color: "#1a1ad6", fontStyle: "italic", textAlign: "center", fontWeight: 400 }}>Unités Tot/<br/>Pds Total</th>
                <th style={{ width: 24 }}></th><th style={{ color: "#1a1ad6", fontStyle: "italic", textAlign: "center", fontWeight: 400 }}>P.A / Kg</th><th style={{ color: "#1a1ad6", fontStyle: "italic", textAlign: "center", fontWeight: 400 }}>P.R devise</th><th style={{ color: "#1a1ad6", fontStyle: "italic", textAlign: "center", fontWeight: 400 }}>P.R / Kg</th>
                <th style={{ width: 24 }}></th><th style={{ color: "#1a1ad6", fontStyle: "italic", textAlign: "center", fontWeight: 400 }}>Montant HT</th>
              </tr></thead>
              <tbody>
                <tr><td style={{ color: "#c000c0", fontStyle: "italic", whiteSpace: "nowrap" }}>Flottant =&gt;</td><td style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") != 3 ? $fmt("nbColis") : 0}</td><td style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") != 3 ? $fmt("nbUnitesParColis") : 0}</td><td style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") != 3 ? $fmt("unitesTot") : 0}</td><td></td><td style={{ background: "#ffd27f", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") != 3 ? $fmt("unitPriceUntaxed") : 0}</td><td style={{ background: "#ffd27f", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") != 3 ? $fmt("paDevise") : 0}</td><td style={{ background: "#ffd27f", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") != 3 ? $fmt("prKg") : 0}</td><td></td><td style={{ background: "#ffd27f", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") != 3 ? $fmt("montantReel") : 0}</td></tr>
                <tr><td style={{ color: "#c000c0", fontStyle: "italic", whiteSpace: "nowrap" }}>Réel =&gt;</td><td style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") == 3 ? $fmt("nbColis") : 0}</td><td style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") == 3 ? $fmt("nbUnitesParColis") : 0}</td><td style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") == 3 ? $fmt("unitesTot") : 0}</td><td></td><td style={{ background: "#ffd27f", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") == 3 ? $fmt("unitPriceUntaxed") : 0}</td><td style={{ background: "#ffd27f", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") == 3 ? $fmt("paDevise") : 0}</td><td style={{ background: "#ffd27f", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") == 3 ? $fmt("prKg") : 0}</td><td></td><td style={{ background: "#ffd27f", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$get("stockMove.statusSelect") == 3 ? $fmt("montantReel") : 0}</td></tr>
                <tr><td style={{ color: "#c000c0", fontStyle: "italic", whiteSpace: "nowrap" }}>Poids en Kg =&gt;</td><td></td><td style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$fmt("poidsParColis")}</td><td style={{ background: "#ffffc4", color: "#1a1ad6", border: "1px solid #c8c8c8", textAlign: "right", padding: "2px 6px", minWidth: 70 }}>{$fmt("poidsTotalNet")}</td></tr>
              </tbody>
            </table>
          </>
        ]]></viewer>
      </field>
    </panel>

    <panel name="lvmeLigneActionsPanel" colSpan="2" itemSpan="12">
      <button name="lvmeHistoriqueProduitBtn" title="Historique produit" icon="clock-history" onClick="action-lvme-historique-produit-open"/>
      <button name="lvmeEtatStockLotBtn" title="État des stocks par lots" icon="box-seam" onClick="action-lvme-etat-stock-lot-open"/>
    </panel>

    <!-- champs techniques (cachés) : gardés pour les actions et les calculs de la ligne -->
    <panel name="lvmeLigneTechPanel" hidden="true" colSpan="12">
      <field name="stockMove" readonly="true" showIf="_cutOffPreview" colSpan="12" form-view="stock-move-form"/>
      <field name="$partnerLanguage" hidden="true"/>
      <field name="$differentLanguageMessage" showTitle="false" hidden="true" readonly="true" colSpan="12"/>
      <field name="lineTypeSelect" onChange="action-stock-move-line-method-empty-line"/>
      <field name="availableStatus" hidden="true" readonly="true" colSpan="4"/>
      <field if="__config__.app.isApp('supplychain')" if-module="axelor-supplychain" name="$invoiced" showTitle="false" readonly="true" showIf="id &amp;&amp; stockMove.statusSelect == 3 &amp;&amp; stockMove.typeSelect != 1" colSpan="4"/>
      <field if="__config__.app.isApp('supplychain')" if-module="axelor-supplychain" name="isQtyRequested" showTitle="false" readonly="true" showIf="isQtyRequested &amp;&amp; product &amp;&amp; product.productTypeSelect != 'service'" colSpan="4"/>
      <field name="fromStockLocation" hidden="true" onChange="action-stock-move-line-group-stock-location-onchange" onSelect="action-stock-move-line-method-compute-from-stock-location-domain"/>
      <field if="__config__.app.getApp('base')?.getManageProductVariants()" name="productModel" readonlyIf="product || $get('stockMove.statusSelect') > 1" canEdit="false" domain="self.isModel = true" form-view="product-form" grid-view="product-grid" colSpan="6"/>
      <field name="qtyInvoiced" readonly="true" colSpan="3" x-scale="$nbDecimalDigitForQty"/>
      <field name="isRealQtyModifiedByUser" hidden="true"/>
      <field name="$availableQty" title="Available qty" hidden="true" readonly="true" type="decimal" x-scale="$nbDecimalDigitForQty"/>
      <field name="$availableQtyForProduct" title="Available qty for product" hidden="true" readonly="true" type="decimal" x-scale="$nbDecimalDigitForQty"/>
      <field name="$trackingNumberConfiguration" hidden="true"/>
      <field name="oldQty" x-scale="$nbDecimalDigitForQty"/>
      <field name="reservedQty" readonly="true" showIf="product &amp;&amp; product.productTypeSelect != 'service'" colSpan="3" x-scale="$nbDecimalDigitForQty"/>
      <field name="requestedReservedQty" hidden="true" readonly="true" colSpan="3" x-scale="$nbDecimalDigitForQty"/>
      <field name="$trackingNumberConfiguration.isPurchaseTrackingManaged" hidden="true"/>
      <field name="$trackingNumberConfiguration.isProductionTrackingManaged" hidden="true"/>
      <field name="$trackingNumberConfiguration.isSaleTrackingManaged" hidden="true"/>
      <field name="stockMove.partner" hidden="true"/>
      <field name="lotFournisseur.dateProduction" title="Date de production" colSpan="6" readonly="true"/>
      <field name="trackingNumber.dateArrivage" title="Date d'arrivage" colSpan="4"/>
      <field name="unitPriceTaxed" hidden="true" x-scale="$nbDecimalDigitForUnitPrice"/>
      <field name="companyUnitPriceUntaxed" hidden="true"/>
      <field name="companyPurchasePrice" hidden="true"/>
      <field name="wapPrice" hidden="true" x-scale="$nbDecimalDigitForUnitPrice"/>
      <field name="nbColis" title="Nb Colis" colSpan="3" readonly="true" x-scale="3"/>
      <field name="poidsParColis" title="Poids/Colis" colSpan="3" readonly="true" x-scale="3"/>
      <field name="nbUnitesParColis" title="Nb unité/colis" colSpan="3" readonly="true" x-scale="3"/>
      <field name="unitesTot" title="Unités Total" colSpan="3" readonly="true" x-scale="3"/>
      <field name="poidsParColisNet" title="Poids/Colis-NET(Kg)" readonly="true" colSpan="3"/>
      <field name="paDevise" title="PA devise" colSpan="3" readonly="true" x-scale="$nbDecimalDigitForUnitPrice"/>
      <field name="prKg" title="Prix de revient (U.V)" colSpan="3" readonly="true" x-scale="$nbDecimalDigitForUnitPrice"/>
      <field name="unitPriceUntaxed" readonly="true" colSpan="3" onChange="action-stock-move-line-record-price-onchange" x-scale="$nbDecimalDigitForUnitPrice"/>
      <field name="prixRevientReel" title="PR réel (avec frais) (€/kg)" colSpan="3" readonly="true" x-scale="10" help="PR d'achat + frais de congélation appliqués"/>
      <field name="margeHt" title="Marge HT (€)" colSpan="3" readonly="true" x-scale="2" showIf="saleOrderLine != null"/>
      <field name="tauxMarge" title="% Marge" colSpan="3" readonly="true" x-scale="2" showIf="saleOrderLine != null"/>
      <field name="stockMove.statusSelect" hidden="true"/>
      <field name="stockMove.typeSelect" hidden="true"/>
      <field name="conformitySelect" onChange="action-stock-move-attrs-change-conformity"/>
      <field name="$isReadOnly" hidden="true"/>
      <field name="description" showTitle="false" colSpan="12" widget="html" x-lite="true"/>
      <field name="regime"/>
      <field name="natureOfTransaction"/>
      <field name="$nbDecimalDigitForQty" hidden="true"/>
      <field name="$nbDecimalDigitForUnitPrice" hidden="true"/>
      <field name="poidsTotalNet"/>
    </panel>
  </panel>
</form>
