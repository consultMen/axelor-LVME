    <page-setup>
        <simple-master-page name="Simple MasterPage" id="2">
            <property name="type">a4</property>
            <property name="orientation">portrait</property>
            <property name="topMargin">1cm</property>
            <property name="leftMargin">1cm</property>
            <property name="rightMargin">1cm</property>
            <property name="bottomMargin">1cm</property>
            <property name="headerHeight">7.4cm</property>
            <property name="footerHeight">0.6cm</property>
            <property name="showHeaderOnFirst">true</property>
            <property name="showFooterOnLast">true</property>
            <page-header>
                <grid id="500">
                    <property name="dataSet">HeaderDS</property>
                    <property name="width">19cm</property>
                    <list-property name="boundDataColumns">
                        <structure><property name="name">stock_move_seq</property><expression name="expression" type="javascript">dataSetRow["stock_move_seq"]</expression><property name="dataType">string</property></structure>
                        <structure><property name="name">commande_no</property><expression name="expression" type="javascript">dataSetRow["commande_no"]</expression><property name="dataType">string</property></structure>
                        <structure><property name="name">client_name</property><expression name="expression" type="javascript">dataSetRow["client_name"]</expression><property name="dataType">string</property></structure>
                        <structure><property name="name">client_adresse</property><expression name="expression" type="javascript">dataSetRow["client_adresse"]</expression><property name="dataType">string</property></structure>
                        <structure><property name="name">transporteur_name</property><expression name="expression" type="javascript">dataSetRow["transporteur_name"]</expression><property name="dataType">string</property></structure>
                        <structure><property name="name">pdf_header</property><expression name="expression" type="javascript">dataSetRow["pdf_header"]</expression><property name="dataType">string</property></structure>
                        <structure><property name="name">TodayDate</property><expression name="expression" type="javascript">new Date()</expression><property name="dataType">date</property></structure>
                    </list-property>
                    <column id="501"><property name="width">9.5cm</property></column>
                    <column id="502"><property name="width">5.5cm</property></column>
                    <column id="503"><property name="width">4cm</property></column>
                    <row id="510">
                        <cell id="511">
                            <property name="colSpan">2</property>
                            <property name="rowSpan">1</property>
                            <property name="textAlign">center</property>
                            <text id="512">
                                <property name="fontSize">9pt</property>
                                <property name="textAlign">center</property>
                                <list-property name="visibility">
                                    <structure>
                                        <property name="format">all</property>
                                        <expression name="valueExpr" type="javascript">row["pdf_header"] == null</expression>
                                    </structure>
                                </list-property>
                                <property name="contentType">html</property>
                                <text-property name="content"><![CDATA[<VALUE-OF format="HTML">row["pdf_header"]</VALUE-OF>]]></text-property>
                            </text>
                            <text id="513">
                                <property name="fontSize">9pt</property>
                                <property name="textAlign">center</property>
                                <list-property name="visibility">
                                    <structure>
                                        <property name="format">all</property>
                                        <expression name="valueExpr" type="javascript">row["pdf_header"] != null</expression>
                                    </structure>
                                </list-property>
                                <property name="contentType">html</property>
                                <text-property name="content"><![CDATA[<div style="text-align:center;line-height:1.35em;">
<span style="font-weight:bold;font-style:italic;font-size:12pt;">L.V.M.E.</span><br/>
<span style="font-size:9pt;">64, Avenue D'HA&Iuml;FA - Immeuble HERMES PARK - 13008 MARSEILLE</span><br/>
<span style="font-style:italic;font-size:11pt;">T&eacute;l. 04 91 83 00 00 - Fax 04 91 83 20 40</span><br/>
<span style="font-size:9pt;">Email : sofrimar@sofrimar.fr</span><br/>
<span style="font-size:9pt;">S.A.R.L. au capital de 1 000 200 &euro; - SIRET:  522 862 689 00026</span><br/>
<span style="font-size:9pt;">Tva intra.: FR 12522 862 689   -   APE : 4638 B</span>
</div>]]></text-property>
                            </text>
                        </cell>
                        <cell id="514">
