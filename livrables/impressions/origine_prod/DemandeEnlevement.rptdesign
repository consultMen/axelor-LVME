    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="HeaderDS" id="3000">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">StockMoveId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">-5</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure><property name="position">1</property><property name="name">stock_move_seq</property><property name="dataType">string</property></structure>
                    <structure><property name="position">2</property><property name="name">commande_no</property><property name="dataType">string</property></structure>
                    <structure><property name="position">3</property><property name="name">client_name</property><property name="dataType">string</property></structure>
                    <structure><property name="position">4</property><property name="name">client_adresse</property><property name="dataType">string</property></structure>
                    <structure><property name="position">5</property><property name="name">transporteur_name</property><property name="dataType">string</property></structure>
                    <structure><property name="position">6</property><property name="name">pdf_header</property><property name="dataType">string</property></structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure><property name="position">1</property><property name="name">stock_move_seq</property><property name="nativeName">stock_move_seq</property><property name="dataType">string</property><property name="nativeDataType">12</property></structure>
                <structure><property name="position">2</property><property name="name">commande_no</property><property name="nativeName">commande_no</property><property name="dataType">string</property><property name="nativeDataType">12</property></structure>
                <structure><property name="position">3</property><property name="name">client_name</property><property name="nativeName">client_name</property><property name="dataType">string</property><property name="nativeDataType">12</property></structure>
                <structure><property name="position">4</property><property name="name">client_adresse</property><property name="nativeName">client_adresse</property><property name="dataType">string</property><property name="nativeDataType">12</property></structure>
                <structure><property name="position">5</property><property name="name">transporteur_name</property><property name="nativeName">transporteur_name</property><property name="dataType">string</property><property name="nativeDataType">12</property></structure>
                <structure><property name="position">6</property><property name="name">pdf_header</property><property name="nativeName">pdf_header</property><property name="dataType">string</property><property name="nativeDataType">12</property></structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
  StockMove.stock_move_seq,
  StockMove.origin as commande_no,
  Partner.name as client_name,
  StockMove.to_address_str as client_adresse,
  Carrier.name as transporteur_name,
  coalesce(PrintingSettingMove.pdf_header, PrintingSettingCompany.pdf_header) as pdf_header
from stock_stock_move as StockMove
left join base_partner as Partner on (Partner.id = StockMove.partner)
left join base_partner as Carrier on (Carrier.id = StockMove.carrier_partner)
left join base_printing_settings as PrintingSettingMove on (PrintingSettingMove.id = StockMove.printing_settings)
left join base_company as Company on (Company.id = StockMove.company)
left join base_printing_settings as PrintingSettingCompany on (PrintingSettingCompany.id = Company.printing_settings)
where StockMove.id = ?]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="LinesDS" id="4000">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">StockMoveId</property>
                    <property name="nativeName"></property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">-5</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure><property name="position">1</property><property name="name">designation</property><property name="dataType">string</property></structure>
                    <structure><property name="position">2</property><property name="name">nb_colis</property><property name="dataType">decimal</property></structure>
                    <structure><property name="position">3</property><property name="name">unites_colis</property><property name="dataType">decimal</property></structure>
                    <structure><property name="position">4</property><property name="name">nb_unites</property><property name="dataType">decimal</property></structure>
                    <structure><property name="position">5</property><property name="name">poids_total</property><property name="dataType">decimal</property></structure>
                    <structure><property name="position">6</property><property name="name">num_lot</property><property name="dataType">string</property></structure>
                    <structure><property name="position">7</property><property name="name">frigo_ligne</property><property name="dataType">string</property></structure>
                    <structure><property name="position">8</property><property name="name">valeur_ht</property><property name="dataType">decimal</property></structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure><property name="position">1</property><property name="name">designation</property><property name="nativeName">designation</property><property name="dataType">string</property><property name="nativeDataType">12</property></structure>
                <structure><property name="position">2</property><property name="name">nb_colis</property><property name="nativeName">nb_colis</property><property name="dataType">decimal</property><property name="nativeDataType">2</property></structure>
                <structure><property name="position">3</property><property name="name">unites_colis</property><property name="nativeName">unites_colis</property><property name="dataType">decimal</property><property name="nativeDataType">2</property></structure>
                <structure><property name="position">4</property><property name="name">nb_unites</property><property name="nativeName">nb_unites</property><property name="dataType">decimal</property><property name="nativeDataType">2</property></structure>
                <structure><property name="position">5</property><property name="name">poids_total</property><property name="nativeName">poids_total</property><property name="dataType">decimal</property><property name="nativeDataType">2</property></structure>
                <structure><property name="position">6</property><property name="name">num_lot</property><property name="nativeName">num_lot</property><property name="dataType">string</property><property name="nativeDataType">12</property></structure>
                <structure><property name="position">7</property><property name="name">frigo_ligne</property><property name="nativeName">frigo_ligne</property><property name="dataType">string</property><property name="nativeDataType">12</property></structure>
                <structure><property name="position">8</property><property name="name">valeur_ht</property><property name="nativeName">valeur_ht</property><property name="dataType">decimal</property><property name="nativeDataType">2</property></structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select
  coalesce(StockMoveLine.product_name, Product.name) as designation,
  StockMoveLine.nb_colis,
  StockMoveLine.nb_unites_par_colis as unites_colis,
  StockMoveLine.unites_tot as nb_unites,
  StockMoveLine.poids_total_net as poids_total,
  TrackingNumber.tracking_number_seq as num_lot,
  FromLocation.name as frigo_ligne,
  (coalesce(StockMoveLine.unit_price_untaxed,0) * coalesce(StockMoveLine.real_qty,0)) as valeur_ht
from stock_stock_move_line as StockMoveLine
inner join stock_stock_move as StockMove on (StockMove.id = StockMoveLine.stock_move)
left join base_product as Product on (Product.id = StockMoveLine.product)
left join stock_tracking_number as TrackingNumber on (TrackingNumber.id = StockMoveLine.tracking_number)
left join stock_stock_location as FromLocation on (FromLocation.id = StockMove.from_stock_location)
where StockMoveLine.stock_move = ?
order by StockMoveLine.sequence, StockMoveLine.id]]></xml-property>
        </oda-data-set>
    </data-sets>
