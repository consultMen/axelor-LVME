                            <label id="534">
                                <property name="fontSize">11pt</property>
                                <property name="fontWeight">bold</property>
                                <property name="fontStyle">italic</property>
                                <property name="color">#404040</property>
                                <property name="marginLeft">1.5cm</property>
                                <text-property name="text">&lt; Transporteur &gt;</text-property>
                            </label>
                        </cell>
                    </row>
                    <row id="540">
                        <property name="height">2.2cm</property>
                        <cell id="541">
                            <property name="verticalAlign">top</property>
                            <grid id="542">
                                <property name="style">boxFrame</property>
                                <property name="width">7.7cm</property>
                                <property name="marginLeft">0.4cm</property>
                                <column id="543"><property name="width">7.7cm</property></column>
                                <row id="544">
                                    <property name="height">2.1cm</property>
                                    <cell id="545">
                                        <property name="verticalAlign">top</property>
                                        <property name="paddingLeft">10pt</property>
                                        <property name="paddingTop">3pt</property>
                                        <data id="546">
                                            <property name="fontSize">10pt</property>
                                            <property name="textAlign">left</property>
                                            <property name="resultSetColumn">client_name</property>
                                        </data>
                                        <text id="547">
                                            <property name="fontSize">10pt</property>
                                            <property name="textAlign">left</property>
                                            <property name="contentType">html</property>
                                            <text-property name="content"><![CDATA[<VALUE-OF format="HTML">if(row["client_adresse"] != null){row["client_adresse"].replace(/\n/g, "<br/>")}</VALUE-OF>]]></text-property>
                                        </text>
                                    </cell>
                                </row>
                            </grid>
                        </cell>
                        <cell id="548">
                            <property name="colSpan">2</property>
                            <property name="rowSpan">1</property>
                            <property name="verticalAlign">top</property>
                            <grid id="549">
                                <property name="width">8.4cm</property>
                                <property name="marginLeft">0.4cm</property>
                                <column id="550"><property name="width">8.4cm</property></column>
                                <row id="551">
                                    <property name="height">1.4cm</property>
                                    <cell id="552">
                                        <property name="style">boxFrame</property>
                                        <property name="verticalAlign">top</property>
                                        <property name="textAlign">center</property>
                                        <data id="553">
                                            <property name="fontSize">11pt</property>
                                            <property name="fontWeight">bold</property>
                                            <property name="textAlign">center</property>
                                            <property name="marginTop">4pt</property>
                                            <property name="resultSetColumn">transporteur_name</property>
                                        </data>
                                    </cell>
                                </row>
                                <row id="554">
                                    <property name="height">0.7cm</property>
                                    <cell id="555">
                                        <property name="verticalAlign">middle</property>
                                        <text id="556">
                                            <property name="fontSize">11pt</property>
                                            <property name="marginTop">6pt</property>
                                            <property name="contentType">html</property>
                                            <text-property name="content"><![CDATA[Commande N&deg; &nbsp;&nbsp;&nbsp;<VALUE-OF>row["commande_no"]</VALUE-OF>]]></text-property>
                                        </text>
                                    </cell>
                                </row>
                            </grid>
                        </cell>
                    </row>
                </grid>
            </page-header>
            <page-footer>
                <text id="580">
                    <property name="fontSize">9pt</property>
                    <property name="textAlign">center</property>
                    <property name="contentType">html</property>
                    <text-property name="content"><![CDATA[<VALUE-OF>pageNumber</VALUE-OF>]]></text-property>
                </text>
            </page-footer>
        </simple-master-page>
    </page-setup>
    <body>
        <table id="600">
            <property name="dataSet">LinesDS</property>
            <property name="width">19cm</property>
            <property name="repeatHeader">true</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">designation</property><expression name="expression" type="javascript">dataSetRow["designation"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">nb_colis</property><expression name="expression" type="javascript">dataSetRow["nb_colis"]</expression><property name="dataType">decimal</property></structure>
                <structure><property name="name">unites_colis</property><expression name="expression" type="javascript">dataSetRow["unites_colis"]</expression><property name="dataType">decimal</property></structure>
                <structure><property name="name">nb_unites</property><expression name="expression" type="javascript">dataSetRow["nb_unites"]</expression><property name="dataType">decimal</property></structure>
                <structure><property name="name">poids_total</property><expression name="expression" type="javascript">dataSetRow["poids_total"]</expression><property name="dataType">decimal</property></structure>
                <structure><property name="name">num_lot</property><expression name="expression" type="javascript">dataSetRow["num_lot"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">frigo_ligne</property><expression name="expression" type="javascript">dataSetRow["frigo_ligne"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">valeur_ht</property><expression name="expression" type="javascript">dataSetRow["valeur_ht"]</expression><property name="dataType">decimal</property></structure>
                <structure>
                    <property name="name">TotalColis</property>
                    <property name="dataType">decimal</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["nb_colis"]</expression>
                        </structure>
                    </list-property>
                </structure>
                <structure>
                    <property name="name">TotalPoids</property>
                    <property name="dataType">decimal</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["poids_total"]</expression>
                        </structure>
                    </list-property>
                </structure>
                <structure>
                    <property name="name">TotalValeur</property>
                    <property name="dataType">decimal</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["valeur_ht"]</expression>
                        </structure>
                    </list-property>
                </structure>
            </list-property>
            <column id="601"><property name="width">8.4cm</property></column>
            <column id="602"><property name="width">1.9cm</property></column>
            <column id="603"><property name="width">1.9cm</property></column>
            <column id="604"><property name="width">1.9cm</property></column>
            <column id="605"><property name="width">2.1cm</property></column>
            <column id="606"><property name="width">2.8cm</property></column>
            <header>
                <row id="610">
                    <property name="height">0.85cm</property>
                    <cell id="611">
                        <property name="style">cellHead</property>
                        <label id="621">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <text-property name="text">Désignation</text-property>
                        </label>
                    </cell>
                    <cell id="612">
                        <property name="style">cellHead</property>
                        <text id="622">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[Nombre<br/>Colis]]></text-property>
                        </text>
                    </cell>
                    <cell id="613">
                        <property name="style">cellHead</property>
                        <text id="623">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[Unit&eacute;s<br/>/ Colis]]></text-property>
                        </text>
                    </cell>
                    <cell id="614">
                        <property name="style">cellHead</property>
                        <text id="624">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[Nb<br/>Unit&eacute;s]]></text-property>
                        </text>
                    </cell>
                    <cell id="615">
                        <property name="style">cellHead</property>
                        <text id="625">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[Poids<br/>Total]]></text-property>
                        </text>
                    </cell>
                    <cell id="616">
                        <property name="style">cellHead</property>
                        <label id="626">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <text-property name="text">N° Lot</text-property>
                        </label>
                    </cell>
                </row>
            </header>
            <detail>
                <row id="630">
                    <property name="height">0.9cm</property>
                    <cell id="631">
                        <property name="style">cellBodyLeft</property>
                        <data id="641">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">left</property>
                            <property name="resultSetColumn">designation</property>
                        </data>
                        <text id="642">
                            <property name="fontSize">9pt</property>
                            <property name="fontStyle">italic</property>
                            <property name="marginLeft">0.8cm</property>
                            <property name="textAlign">left</property>
                            <list-property name="visibility">
                                <structure>
                                    <property name="format">all</property>
                                    <expression name="valueExpr" type="javascript">row["frigo_ligne"] == null</expression>
                                </structure>
                            </list-property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[Frigo : &nbsp;<VALUE-OF>row["frigo_ligne"]</VALUE-OF>]]></text-property>
                        </text>
                    </cell>
                    <cell id="632">
                        <property name="style">cellBody</property>
                        <text id="643"><property name="fontSize">9pt</property><property name="textAlign">center</property><property name="contentType">html</property><text-property name="content"><![CDATA[<VALUE-OF>row["nb_colis"]==null?"":String(parseFloat(row["nb_colis"].toString())).replace(".",",")</VALUE-OF>]]></text-property></text>
                    </cell>
                    <cell id="633">
                        <property name="style">cellBody</property>
                        <text id="644"><property name="fontSize">9pt</property><property name="textAlign">center</property><property name="contentType">html</property><text-property name="content"><![CDATA[<VALUE-OF>row["unites_colis"]==null?"":String(parseFloat(row["unites_colis"].toString())).replace(".",",")</VALUE-OF>]]></text-property></text>
                    </cell>
                    <cell id="634">
                        <property name="style">cellBody</property>
                        <text id="645"><property name="fontSize">9pt</property><property name="textAlign">center</property><property name="contentType">html</property><text-property name="content"><![CDATA[<VALUE-OF>row["nb_unites"]==null?"":String(parseFloat(row["nb_unites"].toString())).replace(".",",")</VALUE-OF>]]></text-property></text>
                    </cell>
                    <cell id="635">
                        <property name="style">cellBody</property>
                        <text id="646"><property name="fontSize">9pt</property><property name="textAlign">center</property><property name="contentType">html</property><text-property name="content"><![CDATA[<VALUE-OF>row["poids_total"]==null?"":String(parseFloat(row["poids_total"].toString())).replace(".",",")</VALUE-OF>]]></text-property></text>
                    </cell>
                    <cell id="636">
                        <property name="style">cellBody</property>
                        <data id="647">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <property name="resultSetColumn">num_lot</property>
                        </data>
                    </cell>
                </row>
            </detail>
            <footer>
                <row id="650">
                    <property name="height">0.1cm</property>
                    <cell id="651">
                        <property name="colSpan">6</property>
                        <property name="rowSpan">1</property>
                        <property name="borderTopColor">#000000</property>
                        <property name="borderTopStyle">solid</property>
                        <property name="borderTopWidth">thin</property>
                        <label id="661"><property name="fontSize">1pt</property></label>
                    </cell>
                </row>
                <row id="670">
                    <property name="height">1.2cm</property>
                    <cell id="671">
                        <property name="colSpan">6</property>
                        <property name="rowSpan">1</property>
                        <label id="681"><property name="fontSize">1pt</property></label>
                    </cell>
                </row>
                <row id="690">
                    <property name="height">0.7cm</property>
                    <cell id="691">
                        <property name="style">cellHead</property>
                        <text id="791">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[D&eacute;claration de valeur HT en &euro;]]></text-property>
                        </text>
                    </cell>
                    <cell id="693"></cell>
                    <cell id="694">
                        <property name="colSpan">2</property>
                        <property name="rowSpan">1</property>
                        <property name="style">cellHead</property>
                        <text id="794">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[Total Colis]]></text-property>
                        </text>
                    </cell>
                    <cell id="696">
                        <property name="colSpan">2</property>
                        <property name="rowSpan">1</property>
                        <property name="style">cellHead</property>
                        <text id="796">
                            <property name="fontSize">9pt</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[Poids Total &nbsp;(kg)]]></text-property>
                        </text>
                    </cell>
                </row>
                <row id="700">
                    <property name="height">0.7cm</property>
                    <cell id="701">
                        <property name="style">totalBox</property>
                        <text id="801">
                            <property name="fontSize">11pt</property>
                            <property name="fontWeight">bold</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[<VALUE-OF>row["TotalValeur"]==null?"":(function(){var n=parseFloat(row["TotalValeur"].toString());var s=n.toFixed(2);var p=s.split(".");var e=p[0];var o="";var c=0;for(var i=e.length-1;i>=0;i--){o=e.charAt(i)+o;c++;if(c%3==0&&i>0){o=" "+o;}}return o+","+p[1];})()</VALUE-OF>]]></text-property>
                        </text>
                    </cell>
                    <cell id="703"></cell>
                    <cell id="704">
                        <property name="colSpan">2</property>
                        <property name="rowSpan">1</property>
                        <property name="style">totalBox</property>
                        <text id="804">
                            <property name="fontSize">11pt</property>
                            <property name="fontWeight">bold</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[<VALUE-OF>row["TotalColis"]==null?"":String(parseFloat(row["TotalColis"].toString())).replace(".",",")</VALUE-OF>]]></text-property>
                        </text>
                    </cell>
                    <cell id="706">
                        <property name="colSpan">2</property>
                        <property name="rowSpan">1</property>
                        <property name="style">totalBox</property>
                        <text id="806">
                            <property name="fontSize">11pt</property>
                            <property name="fontWeight">bold</property>
                            <property name="textAlign">center</property>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[<VALUE-OF>row["TotalPoids"]==null?"":String(parseFloat(row["TotalPoids"].toString())).replace(".",",")</VALUE-OF>]]></text-property>
                        </text>
                    </cell>
                </row>
            </footer>
        </table>
    </body>
</report>
